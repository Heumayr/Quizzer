<base:WindowBase x:Class="Quizzer.Views.QuestionsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Quizzer.Views"
        xmlns:base="clr-namespace:Quizzer.Base"
        mc:Ignorable="d"
        Title="Fragen" Height="450" Width="800">
    <base:WindowBase.DataContext>
        <local:QuestionsViewModel />
    </base:WindowBase.DataContext>
    <Grid Background="Black">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Margin="5">
            <!-- Der Typ wird jetzt im Anlegen-Fenster gewaehlt, mit Namen und Erklaerung. -->
            <Button Content="Neue Frage" Command="{Binding AddQuestionCommand}" MinWidth="150" />
            <Button Content="Frage duplizieren" Command="{Binding DuplicateQuestionCommand}"
                    MinWidth="150" Margin="8,0,0,0"
                    ToolTip="Legt eine Kopie samt Schritten an und öffnet sie zum Bearbeiten." />
            <Button Content="Frage entfernen" Command="{Binding RemoveQuestionCommand}"
                    Style="{StaticResource DangerButton}" MinWidth="150" Margin="0,4,0,0" />
        </StackPanel>

        <DataGrid Grid.Column="1" ItemsSource="{Binding QuestionsView}" AutoGenerateColumns="False" Margin="5" CanUserAddRows="False" IsReadOnly="True"
                  base:DataGridSelectedItemsBehavior.SelectedItems="{Binding SelectedQuestions}"
                  base:DataGridRowDoubleClickBehavior.DoubleClickCommand="{Binding OpenQuestionCommand}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Bezeichnung" Binding="{Binding Designation}" Width="2*" />
                <DataGridTextColumn Header="Kurz" Binding="{Binding DesignationShort}" Width="0.6*" />
                <!-- Ohne diese Spalte war einer fertigen Frage nirgends anzusehen, welcher Typ sie ist. -->
                <DataGridTextColumn Header="Typ" Binding="{Binding TypDisplayName}" Width="*" />
                <DataGridTextColumn Header="Kategorie" Binding="{Binding Category.Designation}" Width="*" />
                <DataGridTextColumn Header="Schwierigkeit" Binding="{Binding Difficulty}" Width="*" />
                <DataGridTextColumn Header="Punkte" Binding="{Binding Points}" Width="0.7*" />
                <DataGridTextColumn Header="Minuspunkte" Binding="{Binding MinusPoints}" Width="0.7*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</base:WindowBase>