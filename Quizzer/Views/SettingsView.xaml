<base:WindowBase x:Class="Quizzer.Views.SettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Quizzer.Views"
        xmlns:base="clr-namespace:Quizzer.Base"
        Title="Einstellungen" Height="700" Width="820">
    <base:WindowBase.DataContext>
        <local:SettingsViewModel />
    </base:WindowBase.DataContext>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock Style="{StaticResource SectionHeader}" Text="Datenordner" />

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" VerticalContentAlignment="Center"
                             Text="{Binding Datenordner, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1" Content="Durchsuchen …" Margin="8,0,0,0" Padding="12,4"
                            Command="{Binding ChooseFolderCommand}"
                            ToolTip="Ordner auswählen, statt den Pfad abzutippen." />
                </Grid>

                <TextBlock Text="{Binding DatenordnerHinweis}" FontSize="12" Opacity="0.8" Margin="2,0,0,0" />
                <TextBlock FontSize="12" Opacity="0.8" Margin="2,2,0,16" TextWrapping="Wrap"
                           Text="Hier liegen Bilder, Medien und Designs. Fehlt eines der Hintergrundbilder, bleibt die Fläche schwarz - nur einem Design, dem eine Textur fehlt, hilft der Auslieferungsstand aus." />

                <TextBlock Style="{StaticResource SectionHeader}" Text="Datenbank" />

                <TextBlock Visibility="{Binding UnlesbarVisibility}" Foreground="#FF8A80"
                           FontSize="12" TextWrapping="Wrap" Margin="2,0,0,6"
                           Text="Die vorgefundene Verbindung war nicht lesbar. In den Feldern stehen die Vorgaben - beim Speichern wird die alte Verbindung ersetzt." />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Server" FontSize="12" Opacity="0.8" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Datenbank" FontSize="12" Opacity="0.8" />

                    <TextBox Grid.Row="1" Grid.Column="0"
                             Text="{Binding Server, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Row="1" Grid.Column="2"
                             Text="{Binding Datenbank, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <CheckBox Margin="0,12,0,0" IsChecked="{Binding Windowsanmeldung}"
                          Content="Mit dem Windows-Konto anmelden"
                          ToolTip="Der Regelfall bei einer örtlichen LocalDB." />

                <Grid Visibility="{Binding AnmeldedatenVisibility}" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Benutzer" FontSize="12" Opacity="0.8" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Kennwort" FontSize="12" Opacity="0.8" />

                    <TextBox Grid.Row="1" Grid.Column="0"
                             Text="{Binding Benutzer, UpdateSourceTrigger=PropertyChanged}" />
                    <PasswordBox x:Name="Kennwortfeld" Grid.Row="1" Grid.Column="2"
                                 PasswordChanged="Kennwortfeld_PasswordChanged" />

                    <TextBlock Grid.Row="2" Grid.ColumnSpan="3" FontSize="12" Opacity="0.8"
                               Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="Das Kennwort wird im Klartext in der Einstellungsdatei abgelegt. Für eine örtliche Datenbank ist die Windows-Anmeldung die bessere Wahl." />
                </Grid>

                <CheckBox Margin="0,10,0,0" IsChecked="{Binding ZertifikatVertrauen}"
                          Content="Dem Serverzertifikat vertrauen"
                          ToolTip="Nötig bei einem Server im Haus, der kein eigenes Zertifikat hat." />

                <TextBlock Text="Das ergibt diese Verbindung" Style="{StaticResource SectionHeader}"
                           Margin="0,16,0,4" />
                <TextBox Text="{Binding Verbindungsvorschau, Mode=OneWay}" IsReadOnly="True"
                         TextWrapping="Wrap" Opacity="0.9" />

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Verbindung prüfen" Command="{Binding TestConnectionCommand}"
                            Padding="12,4"
                            ToolTip="Fragt den Server, ohne etwas anzulegen oder zu speichern." />
                </StackPanel>

                <TextBlock Text="{Binding Verbindungsbefund}" Visibility="{Binding BefundVisibility}"
                           FontSize="12" TextWrapping="Wrap" Margin="2,6,0,0" />

                <TextBlock FontSize="12" Opacity="0.8" Margin="2,8,0,0" TextWrapping="Wrap"
                           Text="Fehlt die Datenbank, fragt das Programm beim nächsten Start, ob es sie anlegen soll." />

                <TextBlock Style="{StaticResource SectionHeader}" Margin="0,20,0,4" Text="Abgelegt unter" />
                <TextBlock Text="{Binding Ablageort}" FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
                <TextBlock FontSize="12" Opacity="0.8" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="Diese Werte überschreiben die ausgelieferten Vorgaben. Sie liegen im Benutzerordner, nicht im Programmordner." />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Auf Vorgaben zurücksetzen" Command="{Binding ResetCommand}"
                    Margin="0,0,8,0" Padding="10,4"
                    ToolTip="Löscht die eigenen Werte. Danach gelten wieder die ausgelieferten." />
            <Button Content="Abbrechen" Command="{Binding CancelCommand}" Margin="0,0,8,0" Padding="10,4" />
            <Button Content="Speichern" Command="{Binding SaveCommand}" Padding="14,4" FontWeight="Bold" />
        </StackPanel>
    </Grid>
</base:WindowBase>
