<base:WindowBase x:Class="Quizzer.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:base="clr-namespace:Quizzer.Base"
        xmlns:local="clr-namespace:Quizzer.Views"
        mc:Ignorable="d"
        Title="Anmelden" Height="420" Width="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <base:WindowBase.DataContext>
        <local:LoginViewModel />
    </base:WindowBase.DataContext>

    <base:WindowBase.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding SignInCommand}" />
    </base:WindowBase.InputBindings>

    <Grid Background="{StaticResource AppBgBrush}" Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Quizzer"
                       FontSize="34" FontWeight="Bold"
                       Foreground="{StaticResource ForegroundBrush}" />
            <TextBlock Text="{Binding Untertitel}"
                       Opacity="0.65" FontSize="14" Margin="0,4,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,24,0,0">
            <TextBlock Text="Spielleiter" Style="{StaticResource SectionHeader}" />

            <ComboBox ItemsSource="{Binding Moderators}"
                      SelectedItem="{Binding SelectedModerator, Mode=TwoWay}"
                      DisplayMemberPath="CalculatedDisplayName"
                      IsEnabled="{Binding HasModerators}"
                      Height="34"
                      ToolTip="Jeder Spielleiter sieht seine eigenen Fragen und den gemeinsamen Bestand." />

            <StackPanel Visibility="{Binding PasswordVisibility}" Margin="0,12,0,0">
                <TextBlock Text="Kennwort" Style="{StaticResource SectionHeader}" />
                <PasswordBox x:Name="Kennwortfeld"
                             PasswordChanged="Kennwortfeld_PasswordChanged"
                             Height="34" />
            </StackPanel>

            <TextBlock Text="{Binding ErrorText}"
                       Visibility="{Binding ErrorVisibility}"
                       Foreground="#FF8A80"
                       Margin="0,10,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- Ohne angelegten Spielleiter stuende hier sonst nur eine leere Liste. -->
        <Border Grid.Row="2" Visibility="{Binding EmptyHintVisibility}"
                Background="{StaticResource PanelBgBrush}"
                BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1"
                CornerRadius="6" Padding="14" Margin="0,20,0,0"
                VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Noch kein Spielleiter angelegt" FontWeight="Bold" />
                <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,6,0,0"
                           Text="Öffne die Mitspielerverwaltung und setze bei mindestens einer Person den Haken „Darf das Quiz leiten“. Bis dahin kannst du ohne Anmeldung weiterarbeiten." />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="{Binding AbbruchText}"
                    ToolTip="Beendet die Anmeldung. Ohne angemeldeten Spielleiter schließt sich das Programm." Command="{Binding CancelCommand}"
                    MinWidth="120" Height="36" Margin="0,0,8,0" />
            <Button Content="Anmelden"
                    ToolTip="Meldet den gewählten Spielleiter an. Seine Fragen stehen danach zur Verfügung." Command="{Binding SignInCommand}"
                    MinWidth="160" Height="36" FontWeight="Bold"
                    IsDefault="True" />
        </StackPanel>
    </Grid>
</base:WindowBase>
