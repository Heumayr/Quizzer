<base:WindowBase x:Class="Quizzer.Views.GamesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Quizzer.Views"
        xmlns:base="clr-namespace:Quizzer.Base"
        mc:Ignorable="d"
        Title="Spiele" Height="450" Width="800">
    <base:WindowBase.DataContext>
        <local:GamesViewModel />
    </base:WindowBase.DataContext>
    <Grid Background="Black">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Margin="5">
            <Button Content="Spiel starten" Command="{Binding StartGameCommand}" />
            <Button Content="Neues Spiel" Command="{Binding AddGameCommand}" />
            <Button Content="Spiel entfernen" Command="{Binding RemoveGameCommand}" Style="{StaticResource DangerButton}" />

            <TextBlock Text="Weitergeben" Style="{StaticResource SectionHeader}" Margin="0,20,0,4" />

            <Button Content="Exportieren …" Command="{Binding ExportGameCommand}"
                    ToolTip="Schreibt das gewählte Spiel samt Fragen, Medien und Design in eine Datei." />
            <Button Content="Importieren …" Command="{Binding ImportGameCommand}" Margin="0,4,0,0"
                    ToolTip="Liest ein Spiel aus einer Datei. Der Spielleiter bist du; die Mitspieler wählst du dabei." />
        </StackPanel>

        <DataGrid Grid.Column="1" ItemsSource="{Binding GamesView}" AutoGenerateColumns="False" Margin="5" CanUserAddRows="False" IsReadOnly="True"
               base:DataGridSelectedItemsBehavior.SelectedItems="{Binding SelectedGames}"
               base:DataGridRowDoubleClickBehavior.DoubleClickCommand="{Binding OpenGameCommand}">
            <DataGrid.Columns>
                <!--
                    Der Knopf steht links neben der Bezeichnung: der Doppelklick startet das
                    Spiel, in den Aufbau geht es ausdruecklich ueber diesen Knopf
                    (Nutzerentscheidung 2026-09-06). Die Bindung laeuft ueber den DataGrid, weil
                    in einer Zelle die Zeile der DataContext ist.
                -->
                <DataGridTemplateColumn Header="" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Bearbeiten" Margin="2" Padding="8,2"
                                    ToolTip="Öffnet den Spielaufbau. Ein Doppelklick auf die Zeile startet das Spiel."
                                    Command="{Binding DataContext.EditGameCommand,
                                                      RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Bezeichnung" Binding="{Binding Designation}" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</base:WindowBase>