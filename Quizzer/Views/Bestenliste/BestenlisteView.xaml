<base:WindowBase x:Class="Quizzer.Views.Bestenliste.BestenlisteView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:base="clr-namespace:Quizzer.Base"
        xmlns:local="clr-namespace:Quizzer.Views.Bestenliste"
        Title="Bestenliste" Height="620" Width="900"
        WindowStartupLocation="CenterOwner">
    <base:WindowBase.DataContext>
        <local:BestenlisteViewModel />
    </base:WindowBase.DataContext>

    <!-- M37 E03: dieselben Kacheln wie in „Meine Statistik", auch ohne Server. -->
    <Grid Background="{StaticResource AppBgBrush}" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Bestenliste über alle Abende" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />

        <TextBlock Grid.Row="1" Text="{Binding Herkunft}" TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,12" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <local:BestenlisteKachelnView DataContext="{Binding Kacheln}" />
        </ScrollViewer>
    </Grid>
</base:WindowBase>
