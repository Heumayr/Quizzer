<base:WindowBase x:Class="Quizzer.Views.QuestionTypes.QuestionPreviewView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Quizzer.Views.QuestionTypes"
        xmlns:base="clr-namespace:Quizzer.Base"
        xmlns:game="clr-namespace:Quizzer.Views.GameViews"
        Title="Vorschau" Height="700" Width="1000">
    <base:WindowBase.DataContext>
        <local:QuestionPreviewViewModel />
    </base:WindowBase.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#161616" Padding="10,6">
            <StackPanel>
                <TextBlock Text="So sehen es die Mitspieler auf dem Beamer." FontWeight="Bold" />
                <TextBlock Text="Dieselbe Anzeige wie im Spiel - was hier steht, steht am Abend genauso da."
                           FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Dasselbe Steuerelement wie im Spielerfenster. -->
        <Border Grid.Row="1" Background="Black" BorderBrush="#3A3A3A" BorderThickness="1" Margin="10">
            <game:QuestionScreenView DataContext="{Binding Beamer}" />
        </Border>

        <Border Grid.Row="2" Background="#161616" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Standanzeige}" FontWeight="Bold" />
                    <TextBlock Text="{Binding Bildschirmart}" FontSize="12" Opacity="0.75" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Von vorn"
                            ToolTip="Springt zurück auf den ersten Bildschirm der Frage." Command="{Binding RestartCommand}" Margin="0,0,8,0" Padding="10,4" />
                    <Button Content="Zurück"
                            ToolTip="Einen Bildschirm zurück - so wie im Spiel die Rücktaste." Command="{Binding BackCommand}" Margin="0,0,8,0" Padding="10,4" />
                    <Button Content="Weiter"
                            ToolTip="Einen Bildschirm weiter - so wie im Spiel die Eingabetaste." Command="{Binding NextCommand}" Margin="0,0,8,0" Padding="14,4" FontWeight="Bold" />
                    <Button Content="Schließen"
                            ToolTip="Schließt die Vorschau. An der Frage ändert sie nichts." Command="{Binding CloseCommand}" Padding="10,4" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</base:WindowBase>
