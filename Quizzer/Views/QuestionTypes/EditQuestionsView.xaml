<base:WindowBase x:Class="Quizzer.Views.QuestionTypes.EditQuestionsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Quizzer.Views.QuestionTypes"
        xmlns:base="clr-namespace:Quizzer.Base"
        xmlns:val="clr-namespace:Quizzer.Validators"
        xmlns:typed="clr-namespace:Quizzer.Views.QuestionTypes.Typed"
        mc:Ignorable="d"
        Title="Frage bearbeiten" Height="720" Width="900" MinWidth="820" MinHeight="520">
    <base:WindowBase.DataContext>
        <local:EditQuestionViewModel />
    </base:WindowBase.DataContext>

    <!--
        BasedOn ist hier kein Schoenheitsfehler, sondern der Unterschied zwischen sichtbar und
        unsichtbar: ein ausdruecklich gesetzter Stil ersetzt den impliziten VOLLSTAENDIG. Ohne
        BasedOn faellt die Schriftfarbe auf den WPF-Standard Schwarz zurueck - auf einem Grund
        von #111111 gemessene 1,1:1. Genau so standen "Grunddaten", "Bewertung", "Einstellungen
        fuer ..." und "Warnungen beim Spielen" unsichtbar da.
    -->
    <base:WindowBase.Resources>
        <Style x:Key="FieldLabel" TargetType="Label"
               BasedOn="{StaticResource {x:Type Label}}">
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="FieldRow" TargetType="StackPanel"
               BasedOn="{StaticResource {x:Type StackPanel}}">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="5,3,5,3" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontWeight" Value="DemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="5,12,5,4" />
        </Style>
    </base:WindowBase.Resources>

    <DockPanel Background="{StaticResource AppBgBrush}">

        <!-- Kopfzeile: welcher Fragetyp hier bearbeitet wird -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBgBrush}"
                BorderThickness="0,0,0,1" Padding="10,8">
            <StackPanel>
                <TextBlock Text="{Binding TypeDisplayName}" FontSize="18" FontWeight="Bold" />
                <TextBlock Text="{Binding TypeHelpText}" TextWrapping="Wrap" Opacity="0.75"
                           Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <!-- Schaltflaechen -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBgBrush}"
                BorderThickness="0,1,0,0" Padding="10,8">
            <DockPanel LastChildFill="False">

            <TextBlock DockPanel.Dock="Left" Text="{Binding RevealSummary}"
                       Visibility="{Binding RevealVisibility}"
                       VerticalAlignment="Center" FontSize="12" Opacity="0.8"
                       TextTrimming="CharacterEllipsis" MaxWidth="320" />

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="In anderen Typ umwandeln" Command="{Binding ConvertTypeCommand}"
                        MinWidth="190" Margin="0,0,8,0"
                        ToolTip="Behält Schritte, Medien und bisherige Ergebnisse. Nur für bereits gespeicherte Fragen." />
                <Button Content="Aufdecken einrichten …" Command="{Binding RevealCommand}"
                        Visibility="{Binding RevealVisibility}"
                        MinWidth="180" Margin="0,0,8,0"
                        ToolTip="Bild wählen und Flächen darüberziehen - oder die Unschärfe einstellen." />
                <Button Content="Vorschau …" Command="{Binding PreviewCommand}"
                        MinWidth="120" Margin="0,0,8,0"
                        ToolTip="Zeigt die Frage so, wie die Mitspieler sie am Beamer sehen - durchschaltbar." />
                <Button Content="Abbrechen"
                        ToolTip="Schließt den Editor, ohne die Änderungen zu schreiben." Command="{Binding CancelCommand}"
                        MinWidth="110" Margin="0,0,8,0" />
                <Button Content="Speichern"
                        ToolTip="Schreibt die Frage samt ihren Schritten, ohne das Fenster zu schließen." Command="{Binding SaveCommand}"
                        MinWidth="110" Margin="0,0,8,0" />
                <Button Content="Speichern und schließen"
                        ToolTip="Schreibt die Frage samt ihren Schritten und kehrt zur Liste zurück." Command="{Binding SaveAndCloseCommand}"
                        MinWidth="180" />
            </StackPanel>

            </DockPanel>
        </Border>

        <!-- Beanstandungen -->
        <Border DockPanel.Dock="Bottom" Visibility="{Binding IssuesVisibility}"
                Background="{StaticResource ControlBgAltBrush}" Padding="10,6" Margin="0">
            <ItemsControl ItemsSource="{Binding Issues}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="!" FontWeight="Bold" MinWidth="16">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="Orange" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                <Setter Property="Foreground" Value="#FF6B6B" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!--
            Der Weg aus der Sackgasse (2026-09-09). Weicht eine Frage von den typeigenen
            Vorgaben ab, ist das ein FEHLER - das Speichern ist damit gesperrt, und der
            abweichende Wert ist in dieser Maske nirgends aenderbar, weil ihn der Fragetyp
            setzt. Ohne diesen Knopf bleibt nur, die Frage zu loeschen.
        -->
        <Border DockPanel.Dock="Bottom" Visibility="{Binding TypeOwnedRepairVisibility}"
                Background="{StaticResource ControlBgAltBrush}" Padding="10,0,10,8">
            <Button Content="Vorgaben des Fragetyps wiederherstellen"
                    ToolTip="Setzt Buzzer-Layout, Anzeigeart, Tastenart und die beiden Schalter auf das, was der Fragetyp vorgibt. Text, Schritte und Punkte bleiben unberührt."
                    HorizontalAlignment="Left"
                    Command="{Binding RepairTypeOwnedValuesCommand}" />
        </Border>

        <!--
            Bewusst NUR senkrecht. Ein waagrechter Rollbalken nimmt dem Inhalt die Breitengrenze -
            und damit hoert TextWrapping auf zu wirken: gemessen am 2026-09-06 ragte der
            Erklaertext des Startblocks danach 180 Punkte aus dem 900 breiten Fenster, gefangen von
            NoWindowOverflowsItsOwnWidth. Gegen zu enge Felder hilft stattdessen die MinWidth am
            Fenster.
        -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="5">

                <TextBlock Text="Grunddaten" Style="{StaticResource SectionHeader}" />

                <StackPanel Style="{StaticResource FieldRow}">
                    <Label Style="{StaticResource FieldLabel}" Content="Bezeichnung *"
                           ToolTip="Vollständiger Name der Frage. Nur intern sichtbar." />
                    <TextBox VerticalContentAlignment="Center" MinWidth="320"
                             Text="{Binding Path=Question.Designation, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Style="{StaticResource FieldRow}">
                    <Label Style="{StaticResource FieldLabel}" Content="Kurzbezeichnung"
                           ToolTip="Steht in der Zelle des Spielfelds. Bleibt sie leer, bleibt die Zelle leer." />
                    <TextBox VerticalContentAlignment="Center" MinWidth="320"
                             Text="{Binding Path=Question.DesignationShort, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Style="{StaticResource FieldRow}">
                    <Label Style="{StaticResource FieldLabel}" Content="Kategorie *"
                           ToolTip="Thematische Zuordnung. Ohne Kategorie lässt sich die Frage nicht speichern." />
                    <ComboBox ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding Path=SelectedCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              DisplayMemberPath="Designation" MinWidth="320" />
                </StackPanel>

                <StackPanel Style="{StaticResource FieldRow}">
                    <Label Style="{StaticResource FieldLabel}" Content="Fragetext"
                           VerticalAlignment="Top"
                           ToolTip="Wird den Spielern angezeigt. Kann leer bleiben, wenn der Text im ersten Schritt steht." />
                    <TextBox Text="{Binding Question.QuestionText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             MinWidth="500" MinHeight="60" MaxHeight="160" />
                </StackPanel>

                <TextBlock Text="Bewertung" Style="{StaticResource SectionHeader}" />

                <StackPanel Style="{StaticResource FieldRow}">
                    <Label Style="{StaticResource FieldLabel}" Content="Punkte *"
                           ToolTip="Grundwert. Schwierigkeit und Spielphase rechnen ihn hoch." />
                    <TextBox VerticalContentAlignment="Center" MinWidth="120">
                        <TextBox.Text>
                            <Binding Path="Question.Points"
                                     UpdateSourceTrigger="PropertyChanged"
                                     ValidatesOnDataErrors="True"
                                     ValidatesOnExceptions="True"
                                     NotifyOnValidationError="True">
                                <Binding.ValidationRules>
                                    <val:PositiveIntValidationRule />
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>

                    <Label Content="Minuspunkte" Margin="20,0,0,0" VerticalAlignment="Center"
                           ToolTip="Abzug bei falscher Antwort." />
                    <TextBox VerticalContentAlignment="Center" MinWidth="120">
                        <TextBox.Text>
                            <Binding Path="Question.MinusPoints"
                                     UpdateSourceTrigger="PropertyChanged"
                                     ValidatesOnDataErrors="True"
                                     ValidatesOnExceptions="True"
                                     NotifyOnValidationError="True">
                                <Binding.ValidationRules>
                                    <val:PositiveIntValidationRule />
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                </StackPanel>

                <StackPanel Style="{StaticResource FieldRow}">
                    <Label Style="{StaticResource FieldLabel}" Content="Schwierigkeit"
                           ToolTip="Stufe 0 bis 15. Fließt in die Punkteberechnung ein." />
                    <ComboBox ItemsSource="{Binding Difficulties}" MinWidth="200"
                              SelectedItem="{Binding Question.Difficulty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <TextBlock Text="{Binding TypeDisplayName, StringFormat=Einstellungen für {0}}"
                           Style="{StaticResource SectionHeader}" />

                <StackPanel Style="{StaticResource FieldRow}" Visibility="{Binding ShowTextOnKeySelectVisibility}">
                    <Label Style="{StaticResource FieldLabel}" Content="Text auf den Tasten"
                           ToolTip="Ob die Spieler den Antworttext am Telefon sehen oder nur den Buchstaben." />
                    <CheckBox VerticalAlignment="Center"
                              IsChecked="{Binding Path=Question.ShowTextOnKeySelect}" />
                </StackPanel>

                <!-- Nur Schaetzfrage -->
                <StackPanel Visibility="{Binding ExpectedValueVisibility}">
                    <StackPanel Style="{StaticResource FieldRow}">
                        <Label Style="{StaticResource FieldLabel}" Content="Geschätzt wird"
                               ToolTip="Bestimmt die Einheiten und die Eingabeart am Telefon." />
                        <ComboBox ItemsSource="{Binding AppreciateValueKinds}" MinWidth="200"
                                  SelectedItem="{Binding AppreciateValueKind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource FieldRow}">
                        <Label Style="{StaticResource FieldLabel}" Content="Einheit"
                               ToolTip="Alle Tipps werden vor dem Vergleich in dieselbe Basiseinheit umgerechnet." />
                        <ComboBox ItemsSource="{Binding AppreciateUnitsForKind}" MinWidth="200"
                                  DisplayMemberPath="Symbol"
                                  SelectedItem="{Binding AppreciateUnit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource FieldRow}" Visibility="{Binding ExpectedNumberVisibility}">
                        <Label Style="{StaticResource FieldLabel}" Content="Richtiger Wert *"
                               ToolTip="Der Sollwert in der gewählten Einheit. Wer am nächsten dran liegt, gewinnt." />
                        <TextBox VerticalContentAlignment="Center" MinWidth="200"
                                 Text="{Binding ExpectedValue, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource FieldRow}" Visibility="{Binding ExpectedDateVisibility}">
                        <Label Style="{StaticResource FieldLabel}" Content="Richtiges Datum *"
                               ToolTip="Der Abstand zum Tipp wird in Tagen gerechnet." />
                        <DatePicker MinWidth="200"
                                    SelectedDate="{Binding ExpectedDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <TextBlock Text="{Binding AppreciateHintText}" TextWrapping="Wrap"
                               Opacity="0.75" Margin="5,3,5,3" />
                </StackPanel>

                <!-- Nur Eigenschaftsfrage und Aufdeckfrage: die Punktekurve (F16) -->
                <StackPanel Visibility="{Binding ProportionalScoreHintVisibility}">
                    <StackPanel Style="{StaticResource FieldRow}">
                        <Label Style="{StaticResource FieldLabel}" Content="Punktekurve"
                               ToolTip="Wie die erreichbaren Punkte mit jedem Hinweis sinken." />
                        <ComboBox ItemsSource="{Binding ScoreReductionModes}" MinWidth="200"
                                  DisplayMemberPath="Bezeichnung"
                                  SelectedValuePath="Modus"
                                  SelectedValue="{Binding Question.ScoreReductionMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource FieldRow}">
                        <Label Style="{StaticResource FieldLabel}" Content="Faktor"
                               ToolTip="Womit multipliziert wird - beim letzten Hinweis oder bei jedem. 0,5 heißt halbieren." />
                        <TextBox VerticalContentAlignment="Center" MinWidth="200"
                                 Text="{Binding ScoreReductionFactor, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>

                    <TextBlock Text="{Binding ScoreReductionHintText}"
                               Opacity="0.75" Margin="5,3" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Nur Multiple Choice -->
                <TextBlock Visibility="{Binding RandomSequenceHintVisibility}"
                           Text="Die Antwortoptionen werden bei jedem Spielen neu gemischt."
                           Opacity="0.75" Margin="5,3" TextWrapping="Wrap" />

                <TextBlock Text="Warnungen beim Spielen" Style="{StaticResource SectionHeader}" />

                <StackPanel Style="{StaticResource FieldRow}">
                    <Label Style="{StaticResource FieldLabel}" Content="Vor der Lösung fragen"
                           ToolTip="Fragt beim Weiterschalten nach, bevor die Lösung aufgedeckt wird." />
                    <CheckBox VerticalAlignment="Center"
                              IsChecked="{Binding Path=Question.WarnOnResultStep}" />
                </StackPanel>

                <StackPanel Style="{StaticResource FieldRow}">
                    <Label Style="{StaticResource FieldLabel}" Content="Vor dem Abschluss fragen"
                           ToolTip="Fragt beim Weiterschalten nach, bevor der Abschlussschritt kommt." />
                    <CheckBox VerticalAlignment="Center"
                              IsChecked="{Binding Path=Question.WarnOnFinishStep}" />
                </StackPanel>

                <StackPanel Style="{StaticResource FieldRow}">
                    <Label Style="{StaticResource FieldLabel}" Content="Notizen" VerticalAlignment="Top"
                           ToolTip="Nur für den Spielleiter. Die Spieler sehen das nicht." />
                    <TextBox Text="{Binding Question.Notes, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             MinWidth="500" MinHeight="50" MaxHeight="140" />
                </StackPanel>

                <!-- Vom Typ gesetzt: sichtbar, aber nicht aenderbar -->
                <Expander Header="Vom Fragetyp festgelegt" Margin="5,12,5,5" Padding="8">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,8"
                                   Text="Diese Werte gehören zum Fragetyp und werden nicht von Hand gesetzt. Würden sie nicht zusammenpassen, zeigt die Spieleransicht 'Not Supported'." />
                        <StackPanel Style="{StaticResource FieldRow}">
                            <Label Style="{StaticResource FieldLabel}" Content="Bedienung am Telefon" />
                            <TextBlock Text="{Binding BuzzerLayoutText}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource FieldRow}">
                            <Label Style="{StaticResource FieldLabel}" Content="Anzeige der Schritte" />
                            <TextBlock Text="{Binding StepLayoutText}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource FieldRow}">
                            <Label Style="{StaticResource FieldLabel}" Content="Beschriftung der Tasten" />
                            <TextBlock Text="{Binding ViewKeyText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <!-- Die Maske des Fragetyps. Was hier steht, entscheidet der Typ -
                     Antwortliste, Hinweisleiter, Sollwert oder Aufdeckschritte. -->
                <ContentControl Content="{Binding Zeileneditor}" Margin="0,4,0,0">
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <typed:ZeileneditorView />
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>


            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</base:WindowBase>
