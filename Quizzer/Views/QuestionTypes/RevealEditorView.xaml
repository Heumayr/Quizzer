<base:WindowBase x:Class="Quizzer.Views.QuestionTypes.RevealEditorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:base="clr-namespace:Quizzer.Base"
        Title="Aufdeckfrage einrichten" Height="760" Width="1080">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Ziehen Sie mit der Maus Flächen über das Bild, bis es verdeckt ist. Im Spiel fällt je Schritt eine Fläche weg - von der ersten zur letzten." />

        <Border Grid.Row="1" Grid.Column="0" Background="#101010" BorderBrush="#3A3A3A" BorderThickness="1">
            <Grid x:Name="Buehne" ClipToBounds="True"
                  MouseLeftButtonDown="Buehne_MouseLeftButtonDown"
                  MouseMove="Buehne_MouseMove"
                  MouseLeftButtonUp="Buehne_MouseLeftButtonUp"
                  Background="Transparent">
                <Image x:Name="Bild" Stretch="Uniform" />
                <Canvas x:Name="Flaechen" IsHitTestVisible="False" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Grid.Column="1" Margin="12,0,0,0">
            <TextBlock Text="Bild" Style="{StaticResource SectionHeader}" />
            <Button Content="Bild wählen …" Click="BildWaehlen_Click" Margin="0,0,0,4" />
            <TextBlock x:Name="Bildname" FontSize="12" Opacity="0.8" TextWrapping="Wrap" Margin="2,0,0,12" />

            <TextBlock Text="Betriebsart" Style="{StaticResource SectionHeader}" />
            <RadioButton x:Name="ModusFlaechen" Content="Flächen aufdecken" GroupName="Modus"
                         Checked="Modus_Changed" Margin="0,0,0,2" />
            <RadioButton x:Name="ModusUnschaerfe" Content="Unschärfe verringern" GroupName="Modus"
                         Checked="Modus_Changed" Margin="0,0,0,8" />

            <StackPanel x:Name="UnschaerfeBlock" Visibility="Collapsed">
                <TextBlock Text="Unschärfe am Anfang" FontSize="12" Opacity="0.8" />
                <Slider x:Name="BlurSchieber" Minimum="5" Maximum="80" TickFrequency="5"
                        IsSnapToTickEnabled="True" ValueChanged="Blur_Changed" />
                <TextBlock x:Name="BlurWert" FontSize="12" Opacity="0.8" Margin="0,0,0,12" />
            </StackPanel>

            <StackPanel x:Name="FlaechenBlock">
                <TextBlock Text="Flächen" Style="{StaticResource SectionHeader}" />
                <TextBlock x:Name="FlaechenZahl" FontSize="12" Opacity="0.8" Margin="2,0,0,4" />
                <Button Content="Letzte Fläche entfernen" Click="LetzteEntfernen_Click" Margin="0,0,0,4" />
                <Button Content="Alle Flächen entfernen" Click="AlleEntfernen_Click"
                        Style="{StaticResource DangerButton}" />
            </StackPanel>

            <TextBlock x:Name="Warnung" Margin="0,12,0,0" TextWrapping="Wrap"
                       Foreground="Wheat" FontSize="12" />
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Abbrechen" Click="Abbrechen_Click" Margin="0,0,8,0" Padding="10,4" />
            <Button Content="Übernehmen" Click="Uebernehmen_Click" Padding="14,4" FontWeight="Bold" />
        </StackPanel>
    </Grid>
</base:WindowBase>
