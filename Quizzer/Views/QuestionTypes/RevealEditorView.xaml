<base:WindowBase x:Class="Quizzer.Views.QuestionTypes.RevealEditorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:base="clr-namespace:Quizzer.Base"
        Title="Aufdeckfrage einrichten" Height="800" Width="1150">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Background="#101010" BorderBrush="#3A3A3A" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="Buehne" Grid.Row="0" ClipToBounds="True"
                      MouseLeftButtonDown="Buehne_MouseLeftButtonDown"
                      MouseMove="Buehne_MouseMove"
                      MouseLeftButtonUp="Buehne_MouseLeftButtonUp"
                      SizeChanged="Buehne_SizeChanged"
                      Background="Transparent">
                    <Image x:Name="Bild" Stretch="Uniform" />
                    <Canvas x:Name="Ueberdeckungen" IsHitTestVisible="False" />
                </Grid>

                <TextBlock x:Name="Buehnenhinweis" Grid.Row="1" Margin="8,6" TextWrapping="Wrap"
                           TextAlignment="Center" Opacity="0.85" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="0" Grid.Column="1" Margin="12,0,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock Text="Schritt 1 — Art wählen" Style="{StaticResource SectionHeader}" />
                <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8" Margin="2,0,0,6"
                           Text="Wie soll das Bild nach und nach preisgegeben werden?" />

                <RadioButton x:Name="ArtAufdecken" GroupName="Art" Checked="Art_Changed" Margin="0,0,0,4">
                    <StackPanel>
                        <TextBlock Text="Aufdecken" FontWeight="Bold" />
                        <TextBlock Text="Sie zeichnen Flächen über das Bild - je Schritt fällt eine Gruppe weg."
                                   FontSize="12" Opacity="0.8" TextWrapping="Wrap" MaxWidth="260" />
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="ArtUnschaerfe" GroupName="Art" Checked="Art_Changed" Margin="0,0,0,4">
                    <StackPanel>
                        <TextBlock Text="Unschärfe" FontWeight="Bold" />
                        <TextBlock Text="Das Bild startet weichgezeichnet und wird je Schritt schärfer."
                                   FontSize="12" Opacity="0.8" TextWrapping="Wrap" MaxWidth="260" />
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="ArtVerpixelt" GroupName="Art" Checked="Art_Changed" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Verpixelt" FontWeight="Bold" />
                        <TextBlock Text="Das Bild startet grob gerastert und wird je Schritt feiner."
                                   FontSize="12" Opacity="0.8" TextWrapping="Wrap" MaxWidth="260" />
                    </StackPanel>
                </RadioButton>

                <TextBlock Text="Schritt 2 — Bild wählen" Style="{StaticResource SectionHeader}" />
                <Button x:Name="BildKnopf" Content="Bild vom Rechner wählen …"
                        ToolTip="Wählt das Bild, das nach und nach aufgedeckt wird." Click="BildWaehlen_Click"
                        Height="34" Margin="0,0,0,4" />
                <TextBlock x:Name="Bildname" FontSize="12" Opacity="0.8" TextWrapping="Wrap" Margin="2,0,0,12" />

                <TextBlock x:Name="SchrittDreiTitel" Style="{StaticResource SectionHeader}" />

                <StackPanel x:Name="StaerkeBlock" Visibility="Collapsed">
                    <TextBlock x:Name="StaerkeTitel" FontSize="12" Opacity="0.8" />
                    <Slider x:Name="StaerkeSchieber" Minimum="5" Maximum="80" TickFrequency="5"
                            IsSnapToTickEnabled="True" ValueChanged="Staerke_Changed" />
                    <TextBlock x:Name="StaerkeWert" FontSize="12" Opacity="0.8" Margin="0,0,0,8" />

                    <TextBlock Text="Wie viele Schritte?" FontSize="12" Opacity="0.8" />
                    <Slider x:Name="SchritteSchieber" Minimum="1" Maximum="10" TickFrequency="1"
                            IsSnapToTickEnabled="True" ValueChanged="Schritte_Changed" />
                    <TextBlock x:Name="SchritteWert" FontSize="12" Opacity="0.8" Margin="0,0,0,8" />
                </StackPanel>

                <StackPanel x:Name="ZeichenBlock" Visibility="Collapsed">
                    <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8" Margin="2,0,0,6"
                               Text="Ziehen Sie mit gedrückter Maustaste Flächen über das Bild. Mehrere Flächen dürfen zusammen zu einem Schritt gehören - erst „Nächster Schritt“ beginnt den nächsten. Ein Klick ohne Ziehen wählt eine Fläche aus; ein zweiter an derselben Stelle die darunter." />

                    <TextBlock Text="Form" FontSize="12" Opacity="0.8" Margin="2,4,0,2" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <RadioButton x:Name="FormRechteck" GroupName="Form" Content="Rechteck"
                                     IsChecked="True" Margin="0,0,12,0" />
                        <RadioButton x:Name="FormDreieck" GroupName="Form" Content="Dreieck" />
                    </StackPanel>

                    <TextBlock Text="Ausgewählte Fläche drehen" FontSize="12" Opacity="0.8"
                               Margin="2,0,0,2" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="15° links"
                                ToolTip="Dreht die gewählte Fläche um 15 Grad gegen den Uhrzeigersinn." Tag="-15" Click="Drehen_Click" />
                        <Button Content="15° rechts"
                                ToolTip="Dreht die gewählte Fläche um 15 Grad im Uhrzeigersinn." Tag="15" Click="Drehen_Click" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="Voriger Schritt"
                                ToolTip="Zeigt, wie das Bild einen Aufdeckschritt früher aussieht." Click="VorigerSchritt_Click" />
                        <Button Content="Nächster Schritt"
                                ToolTip="Zeigt, wie das Bild einen Aufdeckschritt später aussieht." Click="NaechsterSchritt_Click" />
                    </StackPanel>

                    <Button Content="Ausgewählte Fläche entfernen"
                            ToolTip="Nimmt die gewählte Fläche heraus. Die übrigen rücken nicht nach." Click="AusgewaehlteEntfernen_Click"
                            Margin="0,0,0,4" />
                    <Button Content="Alle Flächen entfernen"
                            ToolTip="Nimmt alle Flächen heraus - das Bild liegt danach frei." Click="AlleEntfernen_Click"
                            Style="{StaticResource DangerButton}" Margin="0,0,0,8" />
                </StackPanel>

                <TextBlock Text="Das ergibt diese Schritte" Style="{StaticResource SectionHeader}" Margin="0,8,0,4" />
                <ItemsControl x:Name="Schrittliste">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="12" Margin="2,1" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="Warnung" Margin="0,12,0,0" TextWrapping="Wrap"
                           Foreground="Wheat" FontSize="12" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Abbrechen"
                    ToolTip="Schließt die Einrichtung, ohne sie zu übernehmen." Click="Abbrechen_Click" Margin="0,0,8,0" Padding="10,4" />
            <Button Content="Übernehmen"
                    ToolTip="Übernimmt Flächen und Schärfestufen in die Frage." Click="Uebernehmen_Click" Padding="14,4" FontWeight="Bold" />
        </StackPanel>
    </Grid>
</base:WindowBase>
