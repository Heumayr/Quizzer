<UserControl x:Class="Quizzer.Views.QuestionTypes.Typed.ZeileneditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Quizzer.Views.QuestionTypes.Typed"
             xmlns:base="clr-namespace:Quizzer.Base">
    <UserControl.Resources>
        <base:BoolToFontWeightConverter x:Key="MediumGewicht" />
        <base:BoolToVisibilityConverter x:Key="OffenSichtbar" />
    </UserControl.Resources>

    <StackPanel>

        <!--
            Der Startbildschirm. Ein eigener Block, keine Zeile: eine Zeile bekommt eine
            Antworttaste, ein Startschritt nie; eine Zeile hat ein Haekchen "richtig", das auf
            einem Startschritt die Frage unspielbar macht. Als Block ist der Fehlerraum leer.
        -->
        <StackPanel Visibility="{Binding StartVisibility}">
            <TextBlock Text="{Binding StartTitel}" Style="{StaticResource SectionHeader}" />
            <TextBox Margin="5,0,5,4" MinHeight="40" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Text="{Binding Start.Text, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Opacity="0.75" Margin="5,0,5,6" TextWrapping="Wrap"
                       Text="Läuft vor der Frage. Die Mitspieler sehen davon nichts - der Startbildschirm ist für sie schwarz, damit niemand die Frage mitlesen kann, während Sie sie vorlesen. Leer lassen heißt: kein eigener Startschritt." />
        </StackPanel>

        <StackPanel Visibility="{Binding ZeilenVisibility}">

            <TextBlock Text="{Binding ZeilenTitel}" Style="{StaticResource SectionHeader}" />

            <ItemsControl ItemsSource="{Binding Zeilen}" Margin="5,0,5,4">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Beschriftet, nicht nackt: die Trefferflaeche umfasst Kaestchen
                                 UND Wort statt nur 13 Bildpunkte, und "richtig" beantwortet die
                                 Frage, die eine leere Box offenlaesst - richtig was? -->
                            <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"
                                      Content="richtig" Padding="4,0,0,0"
                                      IsChecked="{Binding IstRichtig, UpdateSourceTrigger=PropertyChanged}"
                                      Visibility="{Binding DataContext.RichtigVisibility,
                                                   RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      ToolTip="Ein Klick markiert diese Antwort als richtig." />

                            <TextBlock Grid.Column="1" Text="{Binding Taste}" MinWidth="22"
                                       VerticalAlignment="Center" Opacity="0.7" FontWeight="Bold"
                                       ToolTip="{Binding DataContext.Tastenerklaerung,
                                                 RelativeSource={RelativeSource AncestorType=UserControl}}" />

                            <TextBox Grid.Column="2" VerticalContentAlignment="Center"
                                     Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <!-- Enter haengt an, statt zu speichern: in einer Maske
                                         voller einzeiliger Felder ist das die haeufigere
                                         Absicht, und der Sprung in die neue Zeile spart den
                                         Griff zur Maus. -->
                                    <KeyBinding Key="Return"
                                                Command="{Binding DataContext.AddRowCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </TextBox.InputBindings>
                            </TextBox>

                            <TextBlock Grid.Column="3" Text="{Binding Zusatz}" Opacity="0.7"
                                       VerticalAlignment="Center" Margin="8,0,0,0" />

                            <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="4,0,0,0"
                                        Visibility="{Binding DataContext.SortierenVisibility,
                                                     RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <Button Content="↑" Style="{StaticResource IconButton}" ToolTip="Nach oben"
                                        Command="{Binding DataContext.MoveUpCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="↓" Style="{StaticResource IconButton}" ToolTip="Nach unten"
                                        Command="{Binding DataContext.MoveDownCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>

                            <Button Grid.Column="5" Content="{Binding Mediumtext}"
                                    Style="{StaticResource IconButton}" MinWidth="66"
                                    FontWeight="{Binding HatMedium,
                                                 Converter={StaticResource MediumGewicht}}"
                                    ToolTip="Bild, Ton oder Video an diese Zeile hängen."
                                    Command="{Binding DataContext.MediaCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />

                            <ToggleButton Grid.Column="6" Content="⌄" MinWidth="30" MinHeight="26"
                                    Padding="2,0" Margin="2,0,0,0"
                                    IsChecked="{Binding IstOffen, Mode=OneWay}"
                                    ToolTip="Einzelheiten zu diesem Schritt - Medium und Kurzform."
                                    Command="{Binding DataContext.ToggleDetailsCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />

                            <Button Grid.Column="7" Content="✕" Style="{StaticResource IconButton}"
                                    ToolTip="Diese Zeile entfernen"
                                    Visibility="{Binding DataContext.ZeilenAendernVisibility,
                                                 RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Command="{Binding DataContext.RemoveRowCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                            </Grid>

                            <!--
                                Die Einzelheiten - in DERSELBEN Maske, nicht in einem zweiten
                                Fenster (Nutzerwunsch 2026-09-06). Zugeklappt kostet der Block
                                nichts; die Zeile bleibt so schmal wie vorher.
                            -->
                            <Border Margin="26,2,26,8" Padding="8" CornerRadius="4"
                                    Background="#1A1A1A" BorderBrush="#3A3A3A" BorderThickness="1"
                                    Visibility="{Binding IstOffen,
                                                 Converter={StaticResource OffenSichtbar}}">
                                <StackPanel>
                                    <TextBlock Text="Text am Beamer (mehrzeilig)" FontSize="12"
                                               Opacity="0.8" Margin="0,0,0,2" />
                                    <TextBox MinHeight="54" AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto" Margin="0,0,0,8"
                                             Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Text="Kurzform am Telefon" FontSize="12"
                                               Opacity="0.8" Margin="0,0,0,2"
                                               Visibility="{Binding DataContext.KurzformVisibility,
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    <TextBox Margin="0,0,0,2"
                                             Visibility="{Binding DataContext.KurzformVisibility,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             Text="{Binding Kurzform, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock Opacity="0.7" FontSize="12" Margin="0,0,0,8"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding DataContext.KurzformVisibility,
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               Text="Leer lassen heißt: dasselbe wie oben. Nur füllen, wenn auf der Taste am Telefon etwas Kürzeres stehen soll." />

                                    <TextBlock Text="{Binding Medienzeile}" FontSize="12"
                                               Opacity="0.8" Margin="0,0,0,2" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Medium wählen …" Padding="10,4" Margin="0"
                                                Command="{Binding DataContext.MediaCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Medium entfernen" Padding="10,4"
                                                Style="{StaticResource DangerButton}"
                                                IsEnabled="{Binding HatMedium}"
                                                Command="{Binding DataContext.RemoveMediaCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" Margin="5,0,5,4"
                        Visibility="{Binding ZeilenAendernVisibility}">
                <Button Content="+ Zeile" Command="{Binding AddRowCommand}" MinWidth="110"
                        ToolTip="Hängt eine leere Zeile an. Leere Zeilen werden nicht gespeichert." />
            </StackPanel>

            <TextBlock Text="{Binding Zeilenhinweis}" Opacity="0.75" Margin="5,0,5,6"
                       TextWrapping="Wrap" />

        </StackPanel>

        <StackPanel Visibility="{Binding AbschlussVisibility}">
            <TextBlock Text="{Binding AbschlussTitel}" Style="{StaticResource SectionHeader}" />
            <TextBox Margin="5,0,5,4" MinHeight="54" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Text="{Binding Abschluss.Text, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="Steht am Ende der Frage auf dem Beamer." Opacity="0.75"
                       Margin="5,0,5,6" TextWrapping="Wrap" />
        </StackPanel>

    </StackPanel>
</UserControl>
