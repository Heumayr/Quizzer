<base:WindowBase x:Class="Quizzer.Views.ImportPlayersView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Quizzer.Views"
        xmlns:base="clr-namespace:Quizzer.Base"
        Title="Mitspieler wählen" Height="480" Width="520">
    <base:WindowBase.DataContext>
        <local:ImportPlayersViewModel />
    </base:WindowBase.DataContext>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="Wer spielt bei diesem Spiel mit? Die Auswahl lässt sich später im Spielaufbau ändern - ohne Auswahl wird das Spiel ohne Mitspieler angelegt." />

        <ListBox Grid.Row="1" ItemsSource="{Binding Spieler}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding Gewaehlt}" Content="{Binding Anzeigename}" Margin="2" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Abbrechen" Command="{Binding CancelCommand}" Margin="0,0,8,0" Padding="10,4" />
            <Button Content="Ohne Mitspieler" Command="{Binding NoneCommand}" Margin="0,0,8,0" Padding="10,4"
                    ToolTip="Legt das Spiel an, ohne jemanden einzutragen." />
            <Button Content="Übernehmen" Command="{Binding AcceptCommand}" Padding="14,4" FontWeight="Bold" />
        </StackPanel>
    </Grid>
</base:WindowBase>
