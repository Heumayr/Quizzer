<UserControl x:Class="Quizzer.Views.GameViews.Sub.UcPlayerResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Quizzer.Views.GameViews.Sub"
             mc:Ignorable="d"
             MinWidth="100"
             MinHeight="350"
             d:DesignHeight="0" d:DesignWidth="0">
    <!--<UserControl.DataContext>
        <local:PlayerResultContext></local:PlayerResultContext>
    </UserControl.DataContext>-->
    <Border BorderThickness="3" BorderBrush="#333333" CornerRadius="2">
        <Grid MinHeight="50" MinWidth="50" Background="{Binding BackgroundBrush}" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center">
                <Label FontSize="18" FontWeight="ExtraBlack" Content="{Binding Player.Designation}"></Label>
            </Grid>

            <Grid Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center">
                <Label FontSize="18" FontWeight="DemiBold" Content="{Binding Player.DisplayName}"></Label>
            </Grid>

            <Border Grid.Row="2" Grid.Column="0" Width="150" Height="150" BorderThickness="3" CornerRadius="10" BorderBrush="#333333">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding PlayerImagePath}"
                         Stretch="Uniform" />
                </Border.Background>
            </Border>

            <Grid Grid.Row="3" Grid.Column="0" x:Name="ScoreGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                </Grid.RowDefinitions>

                <Label Grid.Column="0" Grid.Row="0" Content="Richtig beantwortet"></Label>
                <CheckBox Grid.Column="1" Grid.Row="0" IsChecked="{Binding CorrectAnswered}" VerticalAlignment="Center"></CheckBox>

                <Label Grid.Column="0" Grid.Row="1" Content="Punkte bisher"></Label>
                <Label Grid.Column="1" Grid.Row="1" Content="{Binding ActualScore, Mode=OneWay}"  HorizontalAlignment="Left"></Label>

                <Label Grid.Column="0" Grid.Row="2" Content="Änderung"></Label>
                <TextBox Grid.Column="1" Grid.Row="2" IsReadOnly="{Binding CanNotEditManipulation}" HorizontalAlignment="Left"
                  Text="{Binding CurrentScoreManipulation, UpdateSourceTrigger=PropertyChanged}" Width="50"></TextBox>

                <Label Grid.Column="0" Grid.Row="3" Content="Punkte danach"></Label>
                <Label Grid.Column="1" Grid.Row="3" Content="{Binding NewScore, Mode=OneWay}"  HorizontalAlignment="Left"></Label>

                <Grid Grid.Column="0" Grid.Row="4" Grid.ColumnSpan="2">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Richtig" Background="DarkGreen" Command="{Binding RightSuggestionCommand}"
                                ToolTip="Gibt die vollen Punkte der Zelle. Bei Hinweisfragen die, die nach den bisher gezeigten Hinweisen noch übrig sind." />
                        <Button Content="Falsch" Command="{Binding WrongSuggestionCommand}"
                                ToolTip="Zieht die Minuspunkte der Zelle ab." />
                        <Button Content="Ohne Wertung" Command="{Binding NoneSuggestionCommand}"
                                ToolTip="Weder Punkte noch Abzug - für alle, die gar nicht dran waren." />
                        <Button Content="Eigener Wert" Command="{Binding CorrectionSuggestionCommand}"
                                ToolTip="Gibt das Punktefeld frei, um eine eigene Zahl einzutragen - auch eine negative." />
                    </StackPanel>
                </Grid>

                <!-- Die Bewertung als Wort: an den vier gleich aussehenden Knoepfen ist nicht
                     zu erkennen, welcher gedrueckt wurde. -->
                <TextBlock Grid.Column="0" Grid.Row="5" Grid.ColumnSpan="2"
                           Text="{Binding SuggestionText}"
                           HorizontalAlignment="Center" Margin="0,6,0,0"
                           FontWeight="SemiBold" Foreground="Wheat" />
            </Grid>

            <StackPanel Grid.Row="4" Visibility="{Binding ShowKeySelections}">

                <TextBlock Text="Tastenwahl"
               Margin="6,6,6,2"
               FontSize="16"
               FontWeight="Bold"
               Foreground="White" />

                <ItemsControl ItemsSource="{Binding KeyViews}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="6"
                        Padding="10"
                        CornerRadius="8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="DarkRed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCorrect}" Value="True">
                                                <Setter Property="Background" Value="DarkGreen" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <StackPanel>
                                    <TextBlock Text="{Binding Key}"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center" />

                                    <TextBlock Text="{Binding Designation}"
                                   Foreground="White"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   Visibility="{Binding ShowDesignationVisibility}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Schaetzfrage: der abgegebene Tipp und wie weit er daneben liegt -->
            <Border Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                    Margin="6,4" Padding="8,5" CornerRadius="6"
                    Background="{Binding AppreciateGuessBrush}"
                    Visibility="{Binding ShowAppreciateGuess}">
                <StackPanel>
                    <TextBlock Text="Geschätzt" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="{Binding AppreciateGuessText}" FontSize="18"
                               Foreground="White" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding AppreciateDistanceText}" Opacity="0.8"
                               Foreground="White" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="6" Grid.Column="0" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <Label Content="Hat gebuzzert"></Label>
                    <CheckBox IsEnabled="False" IsChecked="{Binding IsBuzzerWinner, Mode=OneWay}" VerticalAlignment="Center"></CheckBox>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>