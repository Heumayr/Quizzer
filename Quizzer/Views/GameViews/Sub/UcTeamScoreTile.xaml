<UserControl x:Class="Quizzer.Views.GameViews.Sub.UcTeamScoreTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="160" d:DesignWidth="360">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Sichtbar" />
    </UserControl.Resources>

    <!-- M37 T3: die Teamkachel. Querformat wie die Spielerkachel, damit sie die flache Leiste fuellt; dunkler Grund,
         damit der Kontrast nicht vom Bild abhaengt. Der Rahmen traegt die Teamfarbe, Symbol und Name stehen trotzdem
         daneben (Vorlage TeamAnzeige) - die Farbe nie allein. -->
    <Grid>
        <Border Background="#CC111111"
                BorderBrush="{Binding Pinsel}"
                BorderThickness="3"
                CornerRadius="8"
                Margin="4"
                Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Platz (nur in der Siegerehrung) und Team -->
                <Viewbox Grid.Row="0" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding PlatzText}" Foreground="#E8C87A" FontWeight="Bold" Margin="0,0,8,0" />
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TeamAnzeige}" Focusable="False"
                                        TextElement.Foreground="Wheat" TextElement.FontWeight="ExtraBold" />
                    </StackPanel>
                </Viewbox>

                <!-- Summe: das Groesste auf der Kachel; "Ohne Team" sagt statt einer Zahl, dass nichts zaehlt -->
                <Viewbox Grid.Row="1" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SummeText}" Foreground="WhiteSmoke" FontWeight="ExtraBold" />
                </Viewbox>

                <!-- Mitglieder klein, je mit ihren eigenen Punkten (F-M37-01) und "wählt" wie auf der Spielerkachel -->
                <Viewbox Grid.Row="2" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding Mitglieder}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding PlayerName}" Foreground="Wheat" FontWeight="Bold" />
                                    <TextBlock Text="{Binding AnzeigePunkte}" Foreground="WhiteSmoke" Margin="6,0,0,0" />
                                    <Border Visibility="{Binding ChoosingVisibility}" Background="#4FC3F7" CornerRadius="4"
                                            Padding="5,0" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="wählt" FontWeight="Bold" Foreground="#111111" />
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Viewbox>
            </Grid>
        </Border>

        <!-- "+300" / "-100" fuer das Team nach einer Frage, oben rechts wie auf der Spielerkachel -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,8,0" Padding="12,2" CornerRadius="12"
                Background="{Binding WechselBrush}" BorderBrush="White" BorderThickness="2" IsHitTestVisible="False"
                Visibility="{Binding WechselAktiv, Converter={StaticResource Sichtbar}}">
            <Viewbox Height="34" Stretch="Uniform">
                <TextBlock Text="{Binding WechselText}" FontWeight="ExtraBold" Foreground="White" />
            </Viewbox>
        </Border>
    </Grid>
</UserControl>
