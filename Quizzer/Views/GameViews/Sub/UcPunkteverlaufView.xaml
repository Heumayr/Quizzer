<UserControl x:Class="Quizzer.Views.GameViews.Sub.UcPunkteverlaufView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:base="clr-namespace:Quizzer.Base"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1600">

    <!-- M37 E06: Punkteverlauf am Spielende, nur WPF-Bordmittel. Das Zeichenfeld hat eine feste Groesse
         (PunkteverlaufViewModel), die Viewbox des Beamers skaliert es. Name und Endstand stehen an jeder Linie. -->
    <Border Padding="40,32" CornerRadius="18"
            Background="#E6101010" BorderBrush="WhiteSmoke" BorderThickness="2"
            base:Bewegung.Einblenden="True" base:Bewegung.Stil="Zoomen">
        <StackPanel>
            <TextBlock Text="Punkteverlauf" FontSize="60" FontWeight="Bold" Foreground="Wheat"
                       HorizontalAlignment="Center" Margin="0,0,0,20" />

            <Grid Width="{Binding ZeichenBreite}" Height="{Binding ZeichenHoehe}">
                <!-- Achsen: Nulllinie, groesster und kleinster Stand, Anfang und Ende -->
                <Canvas>
                    <Line X1="{Binding LinksX}" X2="{Binding RechtsX}" Y1="{Binding NullLinieY}" Y2="{Binding NullLinieY}"
                          Stroke="#88FFFFFF" StrokeThickness="2" StrokeDashArray="4 4" />
                    <TextBlock Text="{Binding ObenText}" Canvas.Left="0" Canvas.Top="{Binding ObenTextY}"
                               FontSize="28" Foreground="#CCFFFFFF" />
                    <TextBlock Text="0" Canvas.Left="0" Canvas.Top="{Binding NullTextY}"
                               FontSize="28" Foreground="#CCFFFFFF" />
                    <TextBlock Text="{Binding UntenText}" Canvas.Left="0" Canvas.Top="{Binding UntenTextY}"
                               FontSize="28" Foreground="#CCFFFFFF" />
                    <TextBlock Text="Start" Canvas.Left="{Binding LinksX}" Canvas.Top="{Binding AchseY}"
                               FontSize="28" Foreground="#CCFFFFFF" />
                    <TextBlock Text="{Binding FragenText}" Canvas.Right="{Binding RechtsAbstand}" Canvas.Top="{Binding AchseY}"
                               FontSize="28" Foreground="#CCFFFFFF" />
                </Canvas>

                <ItemsControl x:Name="Linien" ItemsSource="{Binding Linien}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Grid />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Canvas>
                                <Polyline Points="{Binding Punkte}" Stroke="{Binding Farbe}" StrokeDashArray="{Binding Strich}"
                                          StrokeThickness="5" StrokeLineJoin="Round" />
                                <Line X1="{Binding EndeX}" Y1="{Binding EndeY}" X2="{Binding NameLinks}" Y2="{Binding NameMitte}"
                                      Stroke="{Binding Farbe}" StrokeThickness="2" />
                                <TextBlock Text="{Binding NameText}" Foreground="{Binding Farbe}" FontSize="30" FontWeight="Bold"
                                           Canvas.Left="{Binding NameLinks}" Canvas.Top="{Binding NameOben}" Margin="6,0,0,0" />
                            </Canvas>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
