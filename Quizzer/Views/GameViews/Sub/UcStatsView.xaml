<UserControl x:Class="Quizzer.Views.GameViews.Sub.UcStatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Quizzer.Views.GameViews.Sub"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid Background="Transparent">

        <!-- Laufender Punktestand. Querformatige Kacheln, die die Leiste ausfuellen: die hohe
             Spielerkarte wurde hier auf ein Zwanzigstel gestaucht, und die Punktzahl kam mit
             rund 14 Bildpunkten an. Ohne Viewbox darum - die Kachel skaliert ihren Inhalt
             selbst und nutzt die ganze Breite. -->
        <Grid Visibility="{Binding ShowNormalStatsView}">
            <ItemsControl ItemsSource="{Binding PlayerStatsContextList}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding TileColumns}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <local:UcPlayerScoreTile />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- finished view -->
        <StackPanel Visibility="{Binding ShowFinishedStatsView}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">

            <!-- winners row -->
            <ItemsControl ItemsSource="{Binding FirstPlacePlayers}"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,30">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Siegerehrung: die Sieger fahren aus der Tiefe herein und federn nach -->
                        <Border Margin="20,0,20,0"
                                Width="{Binding CardWidth}"
                                Height="{Binding CardHeight}"
                                Opacity="0"
                                RenderTransformOrigin="0.5,1">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="0.4" ScaleY="0.4" />
                            </Border.RenderTransform>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard BeginTime="0:0:0.6">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.4" />
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.9">
                                                <DoubleAnimation.EasingFunction>
                                                    <ElasticEase EasingMode="EaseOut" Oscillations="2" Springiness="6" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.9">
                                                <DoubleAnimation.EasingFunction>
                                                    <ElasticEase EasingMode="EaseOut" Oscillations="2" Springiness="6" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                            <Viewbox Stretch="Uniform">
                                <local:UcPlayerStatsView Width="220" Height="340" />
                            </Viewbox>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- others row -->
            <ItemsControl ItemsSource="{Binding OtherPlayers}"
                          HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Die uebrigen gleiten danach von unten ein -->
                        <Border Margin="12,0,12,0"
                                Width="{Binding CardWidth}"
                                Height="{Binding CardHeight}"
                                Opacity="0">
                            <Border.RenderTransform>
                                <TranslateTransform Y="60" />
                            </Border.RenderTransform>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard BeginTime="0:0:0.2">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.5" />
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y" To="0" Duration="0:0:0.6">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                            <Viewbox Stretch="Uniform">
                                <local:UcPlayerStatsView Width="220" Height="340" />
                            </Viewbox>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</UserControl>