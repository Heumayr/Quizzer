<UserControl x:Class="Quizzer.Views.GameViews.Sub.UcStatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Quizzer.Views.GameViews.Sub"
             xmlns:base="clr-namespace:Quizzer.Base"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid Background="Transparent">

        <!-- Laufender Punktestand. Querformatige Kacheln, die die Leiste ausfuellen: die hohe
             Spielerkarte wurde hier auf ein Zwanzigstel gestaucht, und die Punktzahl kam mit
             rund 14 Bildpunkten an. Ohne Viewbox darum - die Kachel skaliert ihren Inhalt
             selbst und nutzt die ganze Breite. -->
        <Grid Visibility="{Binding ShowNormalStatsView}">
            <ItemsControl ItemsSource="{Binding PlayerStatsContextList}" Visibility="{Binding EinzelkachelnVisibility}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding TileColumns}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <local:UcPlayerScoreTile />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- M37 T3: im Teamspiel je Team eine Kachel mit der Summe, die Mitglieder klein darunter -->
            <ItemsControl ItemsSource="{Binding TeamKacheln}" Visibility="{Binding TeamkachelnVisibility, FallbackValue=Collapsed}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding TeamColumns}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <local:UcTeamScoreTile />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- finished view: die Spielerkarten der Siegerehrung (M37 E3, StatsContext.Siegerehrung) - ohne Teams die erste
             Tafel, im Teamspiel die Einzelwertung nach dem Siegerteam (T3) -->
        <StackPanel Visibility="{Binding SiegerVisibility}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">

            <!-- winners row -->
            <ItemsControl ItemsSource="{Binding FirstPlacePlayers}"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,30">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Siegerehrung: die Sieger zoomen herein (Bewegung - folgt dem Schalter) -->
                        <Border Margin="20,0,20,0"
                                Width="{Binding CardWidth}"
                                Height="{Binding CardHeight}"
                                base:Bewegung.Einblenden="True"
                                base:Bewegung.Stil="Zoomen">
                            <Viewbox Stretch="Uniform">
                                <local:UcPlayerStatsView Width="220" Height="340" />
                            </Viewbox>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- others row -->
            <ItemsControl ItemsSource="{Binding OtherPlayers}"
                          HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Die uebrigen gleiten von unten ein -->
                        <Border Margin="12,0,12,0"
                                Width="{Binding CardWidth}"
                                Height="{Binding CardHeight}"
                                base:Bewegung.Einblenden="True"
                                base:Bewegung.Stil="Gleiten">
                            <Viewbox Stretch="Uniform">
                                <local:UcPlayerStatsView Width="220" Height="340" />
                            </Viewbox>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- M37 T3: im Teamspiel ist der Sieger das Team - bei Gleichstand alle gleichauf liegenden, darunter die uebrigen.
             DownOnly wie der Rueckblick: in der schmalen Leiste des Spielleiters verkleinert statt abgeschnitten. -->
        <Viewbox Visibility="{Binding TeamSiegerVisibility, FallbackValue=Collapsed}" Stretch="Uniform" StretchDirection="DownOnly">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{Binding SiegerTeamsTitel}" FontSize="56" FontWeight="ExtraBold" Foreground="#E8C87A"
                           HorizontalAlignment="Center" Margin="0,0,0,16" />

                <ItemsControl ItemsSource="{Binding SiegerTeams}" HorizontalAlignment="Center" Margin="0,0,0,30">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="20,0" Width="560" Height="300"
                                    base:Bewegung.Einblenden="True" base:Bewegung.Stil="Zoomen">
                                <local:UcTeamScoreTile />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding UebrigeTeams}" HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="12,0" Width="400" Height="200"
                                    base:Bewegung.Einblenden="True" base:Bewegung.Stil="Gleiten">
                                <local:UcTeamScoreTile />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Viewbox>

        <!-- M37 E04: Rueckblick auf den Abend. DownOnly: am Beamer steht er schon in einer Viewbox, in der
             schmalen Leiste des Spielleiters wird er verkleinert statt abgeschnitten. FallbackValue: bis die
             Bindung greift, stuende er sonst sichtbar und 1500 breit im Fenster (AllWindowsBuildUnitTests). -->
        <Viewbox Visibility="{Binding RueckblickVisibility, FallbackValue=Collapsed}" Stretch="Uniform" StretchDirection="DownOnly">
            <local:UcAbendrueckblickView DataContext="{Binding Rueckblick}" />
        </Viewbox>

        <!-- M37 E06: Punkteverlauf, dieselbe Fassung wie der Rueckblick -->
        <Viewbox Visibility="{Binding VerlaufVisibility, FallbackValue=Collapsed}" Stretch="Uniform" StretchDirection="DownOnly">
            <local:UcPunkteverlaufView DataContext="{Binding Verlauf}" />
        </Viewbox>
    </Grid>
</UserControl>