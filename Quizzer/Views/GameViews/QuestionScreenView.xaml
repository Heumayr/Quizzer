<UserControl x:Class="Quizzer.Views.GameViews.QuestionScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:typed="clr-namespace:Quizzer.Views.GameViews.QuestionViews.Typed"
             xmlns:questions="clr-namespace:Quizzer.Views.GameViews.QuestionViews">
    <!--
        Die Frageanzeige des Beamers - Fragenart, Frage, Schrittinhalt.

        Sie steht in einem eigenen Steuerelement, weil die Vorschau im Frageneditor dieselbe
        Anzeige benutzen soll (Nutzerwunsch vom 2026-09-06). Eine nachgebaute Vorschau zeigt
        frueher oder spaeter etwas anderes als der Abend - und genau das ist an diesem Tag schon
        zweimal passiert: die doppelte Frage und "Frage und Antwort zugleich".
    -->
    <UserControl.Resources>
        <questions:QuestionStepTemplateSelector x:Key="QuestionStepTemplateSelector" />

        <DataTemplate x:Key="DefaultStepTemplate">
            <typed:DefaultStepView />
        </DataTemplate>

        <DataTemplate x:Key="MultipleChoiceStepTemplate">
            <typed:MultipleChoiceStepView />
        </DataTemplate>

        <DataTemplate x:Key="PropertiesStepTemplate">
            <typed:PropertiesStepView />
        </DataTemplate>

        <DataTemplate x:Key="AppreciateStepTemplate">
            <typed:AppreciateStepView />
        </DataTemplate>

        <DataTemplate x:Key="RevealStepTemplate">
            <typed:RevealStepView />
        </DataTemplate>
    </UserControl.Resources>

        <Grid Visibility="{Binding ShowQuestionView}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Die Frage als schmale Kopfzeile - erst ab dem dritten Bildschirm. Davor
                 steht auf dem Startbildschirm nur die Fragenart und auf dem ersten
                 Inhaltsbildschirm die Frage gross in der Mitte; zweimal dieselbe Frage auf
                 einem Bildschirm ist unschoen. Collapsed statt Hidden: sonst bliebe die
                 Zeile als leerer Streifen stehen. -->
            <Grid Grid.Row="0" Background="Black" MaxHeight="100"
                  Visibility="{Binding ShowQuestionTop}">
                <Viewbox Margin="5" Stretch="Uniform">
                    <TextBlock Text="{Binding QuestionText}"
                           Foreground="WhiteSmoke"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           MaxWidth="900"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center" />
                </Viewbox>
            </Grid>

            <Grid Grid.Row="1">
                <ContentControl Content="{Binding QuestionStepViewContext}"
                            ContentTemplateSelector="{StaticResource QuestionStepTemplateSelector}" />

                <!-- Bildschirm 1: nur die Fragenart, gross und mittig. KEIN Fragetext -
                     der Spielleiter liest die Frage vor, und wer buzzert, bevor sie zu Ende
                     gelesen ist, darf sie nicht lesen koennen (Nutzerwort vom 2026-09-06).

                     Deckend schwarz, nicht durchscheinend: darunter liegt der Startschritt,
                     und dessen Text ist bei jeder Demofrage der Fragetext selbst. Bei 80
                     Prozent Deckung waere er lesbar - und die Spielregel waere ausgehebelt,
                     ohne dass es jemandem auffiele. -->
                <Border Visibility="{Binding ShowQuestionTypeCentered}"
                        Background="Black"
                        Padding="40">
                    <!--
                        Deutlich kleiner als der Fragetext darunter: der Name einer Fragenart
                        ist EIN Wort, und eine Viewbox zieht ein Wort auf die volle Hoehe auf.
                        Bis 2026-09-06 stand er in demselben Rahmen wie ein ganzer Fragesatz
                        und fuellte den Beamer - gemeldet als "etwas zu gross".
                    -->
                    <Viewbox Stretch="Uniform" MaxHeight="200" MaxWidth="900">
                        <TextBlock Text="{Binding QuestionTypeName}"
                                   Foreground="WhiteSmoke"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   MaxWidth="1100"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </Viewbox>
                </Border>

                <!-- Bildschirm 2: die Frage gross und mittig - der Augenblick, in dem der
                     Spielleiter sie freigibt. Ab dem naechsten Bildschirm steht sie oben. -->
                <Border Visibility="{Binding ShowQuestionCentered}"
                        Background="Black"
                        Padding="40">
                    <Viewbox Stretch="Uniform" MaxHeight="620">
                        <TextBlock Text="{Binding QuestionText}"
                                   Foreground="WhiteSmoke"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   MaxWidth="1100"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </Viewbox>
                </Border>
            </Grid>
        </Grid>
</UserControl>
