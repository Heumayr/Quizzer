<local:UserControlStepViewBase x:Class="Quizzer.Views.GameViews.QuestionViews.Typed.AppreciateStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Quizzer.Views.GameViews.QuestionViews.Typed"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Nur fuer den Spielleiter: Zustand des Schritts -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left"
                    Visibility="{Binding MasterViewVisibility}" Margin="4">
            <Label Content="Loesung:" />
            <CheckBox VerticalContentAlignment="Center" IsEnabled="False"
                      IsChecked="{Binding Step.IsResult}" />
            <Label Content="Abschluss:" Margin="12,0,0,0" />
            <CheckBox VerticalContentAlignment="Center" IsEnabled="False"
                      IsChecked="{Binding Step.IsFinish}" />
        </StackPanel>

        <!-- Schritt-Inhalt: Medium und Text -->
        <Grid Grid.Row="1" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="{Binding ResourceRowHeight}" />
                <RowDefinition Height="{Binding StepTextRowHeight}" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="4" ClipToBounds="True"
                  Visibility="{Binding HasResourceVisibility}">
                <local:ResourceViewerControl
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    DataContext="{Binding Step}"
                    RootFolder="{Binding DataContext.ResourceRootFolder, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    IsMasterView="{Binding DataContext.IsMasterView, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    AudioPlaceholderFile="{Binding DataContext.AudioPlaceholderFile, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            </Grid>

            <Border Grid.Row="1" Background="{Binding TextBackgroundBrush}"
                    Visibility="{Binding HasStepTextVisibility}">
                <Grid Margin="4" ClipToBounds="True">
                    <Viewbox Stretch="Uniform" StretchDirection="Both"
                             HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">
                        <TextBlock Text="{Binding Step.StepText}"
                                   Foreground="{Binding TextForgroundBrush}"
                                   TextWrapping="Wrap" TextAlignment="Center" />
                    </Viewbox>
                </Grid>
            </Border>
        </Grid>

        <!-- Aufforderung, solange die Aufloesung aussteht -->
        <Viewbox Grid.Row="2" Stretch="Uniform" StretchDirection="DownOnly"
                 MaxHeight="70" Margin="10,6"
                 Visibility="{Binding AppreciateAskVisibility}">
            <TextBlock Text="{Binding AppreciateAskText}"
                       Foreground="{Binding TextForgroundBrush}"
                       TextAlignment="Center" TextWrapping="Wrap" />
        </Viewbox>

        <!-- Der richtige Wert: beim Spielleiter immer, auf dem Spielerbildschirm erst am Ende -->
        <Border Grid.Row="3" Margin="10,4,10,10" Padding="10,6"
                Background="#22FFFFFF" CornerRadius="4"
                Visibility="{Binding AppreciateExpectedVisibility}">
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="90">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Richtig: " Foreground="{Binding TextForgroundBrush}" />
                    <TextBlock Text="{Binding AppreciateExpectedText}" FontWeight="Bold"
                               Foreground="{Binding TextForgroundBrush}" />
                </StackPanel>
            </Viewbox>
        </Border>
    </Grid>
</local:UserControlStepViewBase>
