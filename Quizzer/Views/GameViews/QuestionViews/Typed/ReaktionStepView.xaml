<local:UserControlStepViewBase x:Class="Quizzer.Views.GameViews.QuestionViews.Typed.ReaktionStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Quizzer.Views.GameViews.QuestionViews.Typed"
             xmlns:base="clr-namespace:Quizzer.Base"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <!--
        Minispiel Reaktion (M35 B3) am Beamer und beim Spielleiter: Regeltext, „Runde n von m",
        danach die Zeiten. Der Sieger traegt Symbol und Text, nie nur eine Farbe. Tippsprint und
        Stoppuhr (M35 C1) nutzen dieselbe Tafel; das Rennen des Tippsprints zeigt dazu Balken, die
        Zahl steht immer daneben.
    -->
    <UserControl.Resources>
        <base:BoolToVisibilityConverter x:Key="BalkenSichtbar" />
    </UserControl.Resources>
    <Grid ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="8,8,8,0" Padding="16,10" CornerRadius="12" Background="#D9101010">
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="90">
                <TextBlock Text="{Binding MinispielRegeltext}" Width="1400" FontSize="40" FontWeight="SemiBold"
                           Foreground="WhiteSmoke" TextWrapping="Wrap" TextAlignment="Center" />
            </Viewbox>
        </Border>

        <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="110" Margin="10,12,10,4">
            <TextBlock Text="{Binding Reaktion.Kopfzeile}" FontSize="56" FontWeight="Bold"
                       Foreground="WhiteSmoke" TextAlignment="Center" />
        </Viewbox>

        <Border Grid.Row="2" Margin="10,4" Padding="8" CornerRadius="8" Background="#33000000"
                Visibility="{Binding HasStepTextVisibility}">
            <TextBlock Text="{Binding Step.StepText}" Foreground="{Binding TextForgroundBrush}" FontSize="28"
                       TextWrapping="Wrap" TextAlignment="Center" />
        </Border>

        <Viewbox Grid.Row="3" Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top" Margin="10,8"
                 Visibility="{Binding Reaktion.ZeilenVisibility}">
            <ItemsControl ItemsSource="{Binding Reaktion.Zeilen}" Width="900">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" MinWidth="240" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="40" Foreground="WhiteSmoke"
                                       TextTrimming="CharacterEllipsis" />
                            <Border Grid.Column="1" Width="300" Height="32" Margin="12,0" CornerRadius="6"
                                    Background="#40FFFFFF" VerticalAlignment="Center"
                                    Visibility="{Binding HatBalken, Converter={StaticResource BalkenSichtbar}}">
                                <Rectangle Fill="DeepSkyBlue" RadiusX="6" RadiusY="6" RenderTransformOrigin="0,0.5">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform ScaleX="{Binding BalkenAnteil}" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Border>
                            <TextBlock Grid.Column="2" Text="{Binding Zeit}" FontSize="40" FontWeight="Bold"
                                       Foreground="WhiteSmoke" TextAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="{Binding SiegerText}" FontSize="40" FontWeight="Bold"
                                       Foreground="Gold" TextAlignment="Right" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Viewbox>
    </Grid>
</local:UserControlStepViewBase>
