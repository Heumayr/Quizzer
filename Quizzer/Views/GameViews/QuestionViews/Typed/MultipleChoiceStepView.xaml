<local:UserControlStepViewBase x:Class="Quizzer.Views.GameViews.QuestionViews.Typed.MultipleChoiceStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Quizzer.Views.GameViews.QuestionViews.Typed"
             xmlns:qv="clr-namespace:Quizzer.DataModels.Enumerations;assembly=Quizzer.DataModels"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <UserControl.Resources>

        <Style x:Key="StretchItemContainerStyle" TargetType="ContentPresenter">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>

        <!--
            Die Kachel einer Antwort (M11-Nachtrag 2026-10-21: "text immer gut lesbar und nicht
            abgeschnitten ... bilder passender platziert ... text in den plaketten ... auswahl
            buchstaben gut lesbar").

            Bis hierher lag der Text in einer Viewbox mit einer *-Spalte: in einer Viewbox ist die
            Breite unendlich, der Text brach nie um und wurde als eine Zeile winzig gerechnet;
            kurzer Text dagegen wurde riesig. Jetzt bricht er bei einer FESTEN Entwurfsbreite um
            und wird nur verkleinert (StretchDirection=DownOnly) - damit tragen alle Kacheln
            dieselbe Schriftgroesse, solange der Text passt, und keine schneidet ab.
        -->
        <DataTemplate x:Key="StepItemTemplate">
            <Border Margin="8"
                    Padding="14"
                    CornerRadius="12"
                    Background="{Binding GridBackground}"
                    Visibility="{Binding SlotVisibility}"
                    Opacity="{Binding SlotOpacity}"
                    IsHitTestVisible="{Binding SlotHitTestVisible}"
                    ClipToBounds="True"
                    SnapsToDevicePixels="True"
                    UseLayoutRounding="True">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Taste als Plakette: dunkler Grund, weisse Schrift - lesbar auf jedem Design -->
                    <StackPanel Grid.Column="0"
                                VerticalAlignment="Center"
                                Margin="0,0,14,0">
                        <Border Width="84"
                                Height="84"
                                CornerRadius="42"
                                Background="#D9101010"
                                BorderBrush="WhiteSmoke"
                                BorderThickness="3"
                                HorizontalAlignment="Center">
                            <Viewbox Margin="12" Stretch="Uniform">
                                <TextBlock Text="{Binding QuestionViewKey}"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           TextAlignment="Center" />
                            </Viewbox>
                        </Border>

                        <!-- Reihenfolgefrage: der richtige Platz, unter der Taste -->
                        <Border Visibility="{Binding SolutionBadgeVisibility}"
                                Background="#D9101010"
                                CornerRadius="6"
                                Padding="8,2"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Center">
                            <TextBlock Text="{Binding SolutionBadge}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="White" />
                        </Border>
                    </StackPanel>

                    <Grid Grid.Column="1">

                        <!-- Bild und Text: Bild oben, so gross es geht; Text darunter -->
                        <Grid Visibility="{Binding TextAndMediaVisibility}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" MinHeight="60" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <local:ResourceViewerControl Grid.Row="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                DataContext="{Binding Step}"
                                RootFolder="{Binding DataContext.ResourceRootFolder, RelativeSource={RelativeSource AncestorType={x:Type local:UserControlStepViewBase}}}"
                                IsMasterView="{Binding DataContext.IsMasterView, RelativeSource={RelativeSource AncestorType={x:Type local:UserControlStepViewBase}}}"
                                AudioPlaceholderFile="{Binding DataContext.AudioPlaceholderFile, RelativeSource={RelativeSource AncestorType={x:Type local:UserControlStepViewBase}}}" />

                            <Viewbox Grid.Row="1"
                                     Margin="0,8,0,0"
                                     MaxHeight="140"
                                     Stretch="Uniform"
                                     StretchDirection="DownOnly">
                                <TextBlock Text="{Binding DisplayText}"
                                           Width="760"
                                           FontSize="40"
                                           FontWeight="SemiBold"
                                           Foreground="WhiteSmoke"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center" />
                            </Viewbox>
                        </Grid>

                        <!-- Nur Text -->
                        <Viewbox Visibility="{Binding TextOnlyVisibility}"
                                 Stretch="Uniform"
                                 StretchDirection="DownOnly"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayText}"
                                       Width="760"
                                       FontSize="46"
                                       FontWeight="SemiBold"
                                       Foreground="WhiteSmoke"
                                       TextWrapping="Wrap"
                                       TextAlignment="Left"
                                       LineHeight="54" />
                        </Viewbox>

                        <!-- Nur Bild: fuellt die Kachel, Seitenverhaeltnis bleibt -->
                        <local:ResourceViewerControl Visibility="{Binding MediaOnlyVisibility}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            DataContext="{Binding Step}"
                            RootFolder="{Binding DataContext.ResourceRootFolder, RelativeSource={RelativeSource AncestorType={x:Type local:UserControlStepViewBase}}}"
                            IsMasterView="{Binding DataContext.IsMasterView, RelativeSource={RelativeSource AncestorType={x:Type local:UserControlStepViewBase}}}"
                            AudioPlaceholderFile="{Binding DataContext.AudioPlaceholderFile, RelativeSource={RelativeSource AncestorType={x:Type local:UserControlStepViewBase}}}" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="GridOnlyLayoutTemplate">
            <DockPanel LastChildFill="True">

                <!-- Zuordnung: die festen Begriffe links, nummeriert; das Raster rechts traegt
                     die gemischten Gegenstuecke. Bei allen anderen Typen zusammengeklappt. -->
                <Border DockPanel.Dock="Left"
                        Visibility="{Binding ZuordnungVisibility}"
                        Width="460"
                        Margin="8"
                        Padding="16"
                        CornerRadius="12"
                        Background="#D9101010">
                    <ItemsControl ItemsSource="{Binding ZuordnungBegriffe}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly"
                                         HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding}"
                                               Width="420"
                                               FontSize="40"
                                               FontWeight="SemiBold"
                                               Foreground="WhiteSmoke"
                                               TextWrapping="Wrap" />
                                </Viewbox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <ItemsControl ItemsSource="{Binding DisplaySteps}"
                              ItemTemplate="{StaticResource StepItemTemplate}"
                              ItemContainerStyle="{StaticResource StretchItemContainerStyle}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="{Binding DisplayGridRows}"
                                         Columns="{Binding DisplayGridColumns}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="NotSupportedTemplate">
            <Grid ClipToBounds="True">
                <TextBlock Text="Diese Frage ist für die gewählte Anzeigeart nicht eingerichtet."
                           TextWrapping="Wrap"
                           MaxWidth="900"
                           Foreground="WhiteSmoke"
                           FontSize="32"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center" />
            </Grid>
        </DataTemplate>

        <!-- only ONE active answer layout -->
        <DataTemplate x:Key="LayoutTemplate">
            <Grid ClipToBounds="True">
                <ContentControl Content="{Binding}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="ContentTemplate"
                                    Value="{StaticResource NotSupportedTemplate}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DisplayLayoutMode}"
                                             Value="{x:Static qv:StepDisplayLayoutMode.Grid}">
                                    <Setter Property="ContentTemplate"
                                            Value="{StaticResource GridOnlyLayoutTemplate}" />
                                </DataTrigger>

                                <DataTrigger Binding="{Binding DisplayLayoutMode}"
                                             Value="{x:Static qv:StepDisplayLayoutMode.Vertical}">
                                    <Setter Property="ContentTemplate"
                                            Value="{StaticResource NotSupportedTemplate}" />
                                </DataTrigger>

                                <DataTrigger Binding="{Binding DisplayLayoutMode}"
                                             Value="{x:Static qv:StepDisplayLayoutMode.Horizontal}">
                                    <Setter Property="ContentTemplate"
                                            Value="{StaticResource NotSupportedTemplate}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </Grid>
        </DataTemplate>

        <!-- player host -->
        <DataTemplate x:Key="PlayerHostTemplate">
            <Grid ClipToBounds="True">
                <ContentControl Content="{Binding}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                ContentTemplate="{StaticResource LayoutTemplate}" />
            </Grid>
        </DataTemplate>

        <!-- master host -->
        <DataTemplate x:Key="MasterHostTemplate">
            <Viewbox Stretch="Uniform"
                     StretchDirection="DownOnly">
                <Border Width="1600"
                        Height="900"
                        ClipToBounds="True">
                    <ContentControl Content="{Binding}"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    ContentTemplate="{StaticResource LayoutTemplate}" />
                </Border>
            </Viewbox>
        </DataTemplate>
    </UserControl.Resources>

    <Grid ClipToBounds="True"
          SnapsToDevicePixels="True"
          UseLayoutRounding="True">

        <ContentControl Content="{Binding}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="ContentTemplate"
                            Value="{StaticResource PlayerHostTemplate}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMasterView}" Value="True">
                            <Setter Property="ContentTemplate"
                                    Value="{StaticResource MasterHostTemplate}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>
    </Grid>
</local:UserControlStepViewBase>