<UserControl x:Class="Quizzer.Views.GameViews.QuestionViews.CurrentQuestionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Quizzer.Views.GameViews.QuestionViews"
             xmlns:base="clr-namespace:Quizzer.Base"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="345" Background="Black" Foreground="WhiteSmoke">
    <UserControl.Resources>
        <base:EqualityMultiConverter x:Key="EqualityMultiConverter" />
    </UserControl.Resources>

    <!-- Die neun schreibgeschuetzten Textfelder rechts (Typ, Bezeichnung, Kategorie, Stufe,
         Phase, Punkte, Minuspunkte, Notizen) sind entfallen. Dieselben Angaben stehen jetzt
         als eine Zeile in der Kopfleiste des Fragefensters. -->
    <Grid Background="Black">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource SectionHeader}" Text="Schritte" Margin="8,8,8,4" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5,0,0,4">
            <Button Content="Zum ersten Schritt" Command="{Binding StartStepCommnad}"
                    ToolTip="Springt zurück an den Anfang der Frage." />
            <!-- Hervorgehoben, weil er der meistgedrueckte Knopf des ganzen Abends ist - er
                 sah bis 2026-09-09 aus wie "Zurueck" daneben. Bewusst OHNE die dunkelgruene
                 Fuellung: die traegt "Bewerten ..." in derselben Maske, und zwei farbige
                 Knoepfe nebeneinander heben einander auf. -->
            <Button Content="Weiter (Enter)" Command="{Binding NextStepCommnad}"
                    FontWeight="Bold" Height="38"
                    ToolTip="Deckt den nächsten Schritt auf. Der Spielerbildschirm folgt." />
            <Button Content="Zurück (Rücktaste)" Command="{Binding BackStepCommnad}"
                    ToolTip="Nimmt den zuletzt aufgedeckten Schritt zurück. Der Spielerbildschirm folgt." />
        </StackPanel>

        <!-- Ohne Viewbox: die Schriftgroesse haengt sonst an der Zahl der Schritte, und eine
             Frage mit vielen Schritten wird unlesbar klein. -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding QuestionOrderedSteps}"
                  AutoGenerateColumns="False"
                  Margin="5"
                  FontSize="13"
                  CanUserAddRows="False"
                  CanUserResizeColumns="True"
                  CanUserReorderColumns="True"
                  CanUserSortColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  base:DataGridSelectedItemsBehavior.SelectedItems="{Binding SelectedSteps}"
                  base:DataGridRowDoubleClickBehavior.DoubleClickCommand="{Binding OpenStepCommand}">

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Value="True">
                            <DataTrigger.Binding>
                                <MultiBinding Converter="{StaticResource EqualityMultiConverter}">
                                    <!-- current row Id -->
                                    <Binding Path="Id" />
                                    <!-- CurrentStep.Id from the DataGrid DataContext -->
                                    <Binding Path="DataContext.CurrentStep.Id"
                                         RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                                </MultiBinding>
                            </DataTrigger.Binding>

                            <Setter Property="Background" Value="DarkGreen" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Nr." Binding="{Binding SequenceNumber}" Width="Auto" />
                <DataGridTextColumn Header="Taste" Binding="{Binding QuestionViewKey}" Width="Auto" />
                <DataGridCheckBoxColumn Header="Lösung" Binding="{Binding IsResult}" Width="Auto" />
                <DataGridCheckBoxColumn Header="Abschluss" Binding="{Binding IsFinish}" Width="Auto" />
                <DataGridTextColumn Header="Bezeichnung" Binding="{Binding Designation}" Width="*" />
                <DataGridTextColumn Header="Medium" Binding="{Binding ResourceTyp}" Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
