<base:WindowBase x:Class="Quizzer.Views.GameViews.PlayersResultView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Quizzer.Views.GameViews"
        xmlns:sub="clr-namespace:Quizzer.Views.GameViews.Sub"
        xmlns:base="clr-namespace:Quizzer.Base"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="700" Width="1100">
    <base:WindowBase.DataContext>
        <local:PlayersResultViewModel></local:PlayersResultViewModel>
    </base:WindowBase.DataContext>
    <!-- M11: alle Kuerzel mit Strg - die Karten haben ein Zahlenfeld, in das sonst getippt wuerde. -->
    <base:WindowBase.InputBindings>
        <KeyBinding Modifiers="Control" Key="R" Command="{Binding QuickRightCommand}" />
        <KeyBinding Modifiers="Control" Key="F" Command="{Binding QuickWrongCommand}" />
        <KeyBinding Modifiers="Control" Key="D0" Command="{Binding QuickNoneCommand}" />
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding SaveCommand}" />
        <KeyBinding Modifiers="Control" Key="Return" Command="{Binding SaveIsDoneFinishStateCommand}" />
        <KeyBinding Modifiers="Control" Key="D1" Command="{Binding SelectCardCommand}" CommandParameter="1" />
        <KeyBinding Modifiers="Control" Key="D2" Command="{Binding SelectCardCommand}" CommandParameter="2" />
        <KeyBinding Modifiers="Control" Key="D3" Command="{Binding SelectCardCommand}" CommandParameter="3" />
        <KeyBinding Modifiers="Control" Key="D4" Command="{Binding SelectCardCommand}" CommandParameter="4" />
        <KeyBinding Modifiers="Control" Key="D5" Command="{Binding SelectCardCommand}" CommandParameter="5" />
        <KeyBinding Modifiers="Control" Key="D6" Command="{Binding SelectCardCommand}" CommandParameter="6" />
        <KeyBinding Modifiers="Control" Key="D7" Command="{Binding SelectCardCommand}" CommandParameter="7" />
        <KeyBinding Modifiers="Control" Key="D8" Command="{Binding SelectCardCommand}" CommandParameter="8" />
        <KeyBinding Modifiers="Control" Key="D9" Command="{Binding SelectCardCommand}" CommandParameter="9" />
    </base:WindowBase.InputBindings>
    <Grid Background="Black">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Die Karten nehmen den Platz, die Knopfleiste bleibt darunter stehen. Bis
                 2026-09-06 war die erste Zeile auf "auto": ab etwa fuenf Mitspielern wuchsen
                 die Karten aus dem Fenster, und die Knoepfe rutschten mit hinaus. -->
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- M11: wer gebuzzert hat, steht oben - mit den Werten, bevor man klickt. -->
        <Border Grid.Row="0" Background="#1B2A1B" Padding="10" Visibility="{Binding WinnerBarVisibility}">
            <DockPanel>
                <TextBlock Text="{Binding WinnerText}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"
                           Foreground="White" Margin="4,0,16,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{Binding WinnerRightText}" Command="{Binding WinnerRightCommand}"
                            Background="DarkGreen" FontSize="18" FontWeight="Bold" Padding="18,6" Margin="0,0,8,0"
                            ToolTip="Setzt für den Buzzer-Gewinner „richtig“. Gespeichert wird erst mit Speichern (Strg+S) oder Abschließen (Strg+Enter)." />
                    <Button Content="{Binding WinnerWrongText}" Command="{Binding WinnerWrongCommand}"
                            Background="DarkRed" FontSize="18" FontWeight="Bold" Padding="18,6"
                            ToolTip="Setzt für den Buzzer-Gewinner „falsch“ mit den Minuspunkten der Zelle. Gespeichert wird erst mit Speichern." />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding PlayerResultContextList}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- Hoechstens vier je Zeile, der Rest bricht um. Bisher wurde durch die
                             Zahl der Spieler geteilt: bei sechs Gaesten blieben je Karte rund
                             133 Bildpunkte, das Spielerbild allein ist 150 breit. -->
                        <UniformGrid Columns="{Binding Columns}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <sub:UcPlayerResultView />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#161616" Padding="8">
            <StackPanel>
            <TextBlock Text="{x:Static local:PlayersResultViewModel.KeyHint}" Foreground="Gray" FontSize="12"
                       HorizontalAlignment="Center" Margin="0,0,0,6" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Speichern" Command="{Binding SaveCommand}"
                        ToolTip="Schreibt die Punkte, das Fenster bleibt offen." />
                <Button Content="Speichern und schließen" Command="{Binding SaveAndCloseCommand}"
                        ToolTip="Schreibt die Punkte und schließt das Fenster. Die Zelle bleibt offen und kann erneut gespielt werden." />
                <!--
                    Dieselbe Handlung wie "Zelle abschliessen" im Fragefenster und deshalb
                    dieselbe Farbe. Bis 2026-09-06 stand hier DarkRed - dieselbe Sache sah in
                    zwei Fenstern verschieden gefaehrlich aus.
                -->
                <Button Content="Speichern und Zelle abschließen" Command="{Binding SaveIsDoneFinishStateCommand}"
                        Background="DarkGreen"
                        ToolTip="Schreibt die Punkte und markiert die Zelle als gespielt." />
            </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</base:WindowBase>
