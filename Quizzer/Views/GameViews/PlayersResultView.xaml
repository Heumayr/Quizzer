<base:WindowBase x:Class="Quizzer.Views.GameViews.PlayersResultView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Quizzer.Views.GameViews"
        xmlns:sub="clr-namespace:Quizzer.Views.GameViews.Sub"
        xmlns:base="clr-namespace:Quizzer.Base"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="700" Width="1100">
    <base:WindowBase.DataContext>
        <local:PlayersResultViewModel></local:PlayersResultViewModel>
    </base:WindowBase.DataContext>
    <Grid Background="Black">
        <Grid.RowDefinitions>
            <!-- Die Karten nehmen den Platz, die Knopfleiste bleibt darunter stehen. Bis
                 2026-09-06 war die erste Zeile auf "auto": ab etwa fuenf Mitspielern wuchsen
                 die Karten aus dem Fenster, und die Knoepfe rutschten mit hinaus. -->
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding PlayerResultContextList}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- Hoechstens vier je Zeile, der Rest bricht um. Bisher wurde durch die
                             Zahl der Spieler geteilt: bei sechs Gaesten blieben je Karte rund
                             133 Bildpunkte, das Spielerbild allein ist 150 breit. -->
                        <UniformGrid Columns="{Binding Columns}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <sub:UcPlayerResultView />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="1" Background="#161616" Padding="8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Speichern" Command="{Binding SaveCommand}"
                        ToolTip="Schreibt die Punkte, das Fenster bleibt offen." />
                <Button Content="Speichern und schließen" Command="{Binding SaveAndCloseCommand}"
                        ToolTip="Schreibt die Punkte und schließt das Fenster. Die Zelle bleibt offen und kann erneut gespielt werden." />
                <!--
                    Dieselbe Handlung wie "Zelle abschliessen" im Fragefenster und deshalb
                    dieselbe Farbe. Bis 2026-09-06 stand hier DarkRed - dieselbe Sache sah in
                    zwei Fenstern verschieden gefaehrlich aus.
                -->
                <Button Content="Speichern und Zelle abschließen" Command="{Binding SaveIsDoneFinishStateCommand}"
                        Background="DarkGreen"
                        ToolTip="Schreibt die Punkte und markiert die Zelle als gespielt." />
            </StackPanel>
        </Border>
    </Grid>
</base:WindowBase>
