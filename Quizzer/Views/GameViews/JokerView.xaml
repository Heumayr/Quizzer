<base:WindowBase x:Class="Quizzer.Views.GameViews.JokerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:base="clr-namespace:Quizzer.Base"
        xmlns:local="clr-namespace:Quizzer.Views.GameViews"
        Title="Joker" Height="680" Width="560"
        WindowStartupLocation="CenterOwner">
    <base:WindowBase.DataContext>
        <local:JokerViewModel />
    </base:WindowBase.DataContext>

    <Grid Background="{StaticResource AppBgBrush}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding GameName}" FontSize="22" FontWeight="Bold" />
            <TextBlock Opacity="0.75" TextWrapping="Wrap" Margin="0,4,0,12"
                       Text="Einen Joker gibst du von Hand, mit Grund. Einlösen kann ihn der Spieler später für eine Frage." />
        </StackPanel>

        <!-- Vergeben -->
        <StackPanel Grid.Row="1">
            <TextBlock Text="Joker geben" Style="{StaticResource SectionHeader}" />
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" ItemsSource="{Binding Players}" SelectedItem="{Binding SelectedPlayer}"
                          DisplayMemberPath="Name" Height="32"
                          ToolTip="Wer den Joker bekommt." />
                <ComboBox Grid.Column="2" ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}"
                          DisplayMemberPath="Name" Height="32"
                          ToolTip="Welcher Joker." />
            </Grid>
            <TextBlock Text="{Binding SelectedKind.Wirkung}" Opacity="0.75" TextWrapping="Wrap" Margin="0,6,0,0" />
            <TextBlock Text="Grund" Margin="0,10,0,2" />
            <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" MaxLength="{Binding MaxReasonLength, Mode=OneTime}"
                     Height="32" VerticalContentAlignment="Center"
                     ToolTip="Wofür der Joker vergeben wird, zum Beispiel „Minispiel gewonnen“." />
            <Button Content="Joker geben" Command="{Binding GrantCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"
                    ToolTip="Gibt dem gewählten Mitspieler den gewählten Joker mit diesem Grund." />
        </StackPanel>

        <!-- Je Mitspieler -->
        <Border Grid.Row="2" Margin="0,16,0,0" Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrushDark}"
                BorderThickness="1" CornerRadius="6" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Players}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,6">
                                <TextBlock FontSize="16" FontWeight="SemiBold">
                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                    <Run Text="–" />
                                    <Run Text="{Binding Summary, Mode=OneWay}" FontWeight="Normal" />
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding Jokers}" Margin="12,2,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" TextWrapping="Wrap" VerticalAlignment="Center">
                                                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                                    <Run Text="{Binding Status, Mode=OneWay, StringFormat=({0})}" />
                                                    <Run Text="{Binding Reason, Mode=OneWay}" />
                                                </TextBlock>
                                                <Button Grid.Column="1" Content="Zurücknehmen" Margin="8,0,0,0"
                                                        Command="{Binding DataContext.WithdrawCommand, RelativeSource={RelativeSource AncestorType=base:WindowBase}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTipService.ShowOnDisabled="True"
                                                        ToolTip="Nimmt einen offenen Joker zurück. Ein eingelöster hat schon gewirkt und bleibt." />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="3" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="#FFD180" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Schließen" Command="{Binding CloseCommand}" MinWidth="110" Height="36" IsCancel="True"
                    ToolTip="Schließt das Fenster. Vergeben und Zurücknehmen sind schon gespeichert." />
        </StackPanel>
    </Grid>
</base:WindowBase>
