<base:WindowBase x:Class="Quizzer.Views.GameViews.QuestionMasterView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Quizzer.Views.GameViews"
        xmlns:base="clr-namespace:Quizzer.Base"
        xmlns:questions="clr-namespace:Quizzer.Views.GameViews.QuestionViews"
        xmlns:buzzerServer="clr-namespace:Quizzer.Views.BuzzerViews"
        xmlns:typed="clr-namespace:Quizzer.Views.GameViews.QuestionViews.Typed"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="800" Width="1300">
    <base:WindowBase.DataContext>
        <local:CurrentQuestionViewModel></local:CurrentQuestionViewModel>
    </base:WindowBase.DataContext>

    <base:WindowBase.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding NextStepCommnad}" />
        <KeyBinding Key="Back" Command="{Binding BackStepCommnad}" />
    </base:WindowBase.InputBindings>

    <Window.Resources>
        <questions:QuestionStepTemplateSelector x:Key="QuestionStepTemplateSelector" />

        <DataTemplate x:Key="DefaultStepTemplate">
            <typed:DefaultStepView IsMasterView="True" />
        </DataTemplate>

        <DataTemplate x:Key="MultipleChoiceStepTemplate">
            <typed:MultipleChoiceStepView IsMasterView="True" />
        </DataTemplate>

        <DataTemplate x:Key="PropertiesStepTemplate">
            <typed:PropertiesStepView IsMasterView="True" />
        </DataTemplate>

        <DataTemplate x:Key="AppreciateStepTemplate">
            <typed:AppreciateStepView IsMasterView="True" />
        </DataTemplate>

        <DataTemplate x:Key="ReaktionStepTemplate">
            <typed:ReaktionStepView IsMasterView="True" />
        </DataTemplate>

        <DataTemplate x:Key="RevealStepTemplate">
            <typed:RevealStepView IsMasterView="True" />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="{Binding BackgroundImagePath}"
             Stretch="UniformToFill" />
        </Grid.Background>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <!-- Kopfleiste: links die Frage, rechts die Angaben, die bisher als neun einzelne
             Textfelder ein Viertel des Fensters belegt haben. -->
        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Background="Black" MaxHeight="110" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Viewbox Grid.Column="0" Margin="5" Stretch="Uniform" HorizontalAlignment="Left">
                <TextBlock Text="{Binding Question.QuestionText}"
                 Foreground="WhiteSmoke"
                 FontWeight="SemiBold"
                 TextWrapping="Wrap"
                 MaxWidth="900"
                 TextAlignment="Left"
                 VerticalAlignment="Center"
                 HorizontalAlignment="Center" />
            </Viewbox>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,4,12,4">
                <TextBlock Text="{Binding QuestionSummary}" FontWeight="Bold" FontSize="14"
                           Foreground="Wheat" TextAlignment="Right" />
                <!-- M11: der Wert JETZT - bei Hinweisfragen sinkt er mit jedem Schritt. -->
                <TextBlock Text="{Binding PointsNowText}" FontWeight="Bold" FontSize="16"
                           Foreground="#7CFC9A" TextAlignment="Right" Margin="0,2,0,0" />
                <TextBlock Text="{Binding QuestionNotesLine}" FontSize="12" Opacity="0.75"
                           TextAlignment="Right" TextWrapping="Wrap" MaxWidth="320"
                           Visibility="{Binding NotesVisibility}" />
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Grid.Column="0" BorderThickness="3" BorderBrush="Black">
            <Grid  MinWidth="200" ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Border Width="4" Background="Wheat" Margin="0,0,6,0" />
                    <TextBlock Text="Jetzt sichtbar" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Text=" (läuft auf dem Beamer)" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                </StackPanel>
                <ContentControl Grid.Row="1"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Stretch"
                      Content="{Binding CurrentStepContext}"
                      ContentTemplateSelector="{StaticResource QuestionStepTemplateSelector}" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" BorderThickness="3" BorderBrush="Black">
            <Grid MinWidth="200"  ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Als Nächstes" FontWeight="Bold" FontSize="14" Margin="10,0,0,0" />
                <ContentControl Grid.Row="1"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch"
                  VerticalContentAlignment="Stretch"
                  Content="{Binding NextStepContext}"
                  ContentTemplateSelector="{StaticResource QuestionStepTemplateSelector}" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Grid.Column="0" BorderThickness="3" BorderBrush="Black">
            <Grid  MinWidth="200" ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Abschluss" FontWeight="Bold" FontSize="14" Margin="10,0,0,0" />
                <ContentControl Grid.Row="1"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch"
                     HorizontalContentAlignment="Stretch"
                     VerticalContentAlignment="Stretch"
                     Content="{Binding FinishStepContext}"
                     ContentTemplateSelector="{StaticResource QuestionStepTemplateSelector}" />
            </Grid>
        </Border>

        <Border Background="Black" Grid.Row="2" Grid.Column="1" BorderThickness="3" BorderBrush="Black">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="auto"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Grid.Column="0">
                    <Border BorderBrush="WhiteSmoke">
                        <buzzerServer:BuzzerControlsView DataContext="{Binding BuzzerControlsViewModel}" />
                    </Border>

                    <!--
                        Laeuft der Buzzer-Server nicht, blieb diese Zeile bis 2026-09-07 einfach
                        leer - und weil das Fragefenster modal ist, kam der Spielleiter nicht
                        einmal an das Buzzer-Fenster heran, um ihn zu starten.
                    -->
                    <Border Visibility="{Binding BuzzerFehltVisibility}"
                            Background="#3A2F10" BorderBrush="#8A6D1F" BorderThickness="1"
                            CornerRadius="6" Padding="10" Margin="4">
                        <TextBlock Text="{Binding BuzzerFehltText}" TextWrapping="Wrap" />
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Grid.Column="0">
                    <questions:CurrentQuestionView />
                </Grid>

                <!--
                    Ueber beide Zeilen, damit die Spielerliste links die Knopfspalte nicht nach
                    unten schiebt. Gemessen am 2026-09-06: vorher stand sie in Zeile 1 und rutschte
                    bei zehn Mitspielern 49 Punkte aus dem Fenster - die beiden untersten Knoepfe
                    waren nicht mehr da.
                -->
                <!--
                    Die Handlungsspalte. Alle sechs Aenderungen vom 2026-09-06 stecken hier
                    (Nutzerentscheidung F10):
                      1  zwei Gruppen statt einer Liste, mit Trennung dazwischen
                      2  eine einzige hervorgehobene Taste - "Bewerten" kommt bei jeder Zelle
                      3  Beschriftungen nach dem Ergebnis statt nach der Mechanik
                      4  die Ueberschrift heisst nicht mehr wie einer der Knoepfe
                      5  der Zustand steht oben, vor der Entscheidung, nicht darunter
                      6  der Neustart der Runde hat eine eigene Gruppe - er ist das Einzige hier,
                         das die Telefone anfasst
                -->
                <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" VerticalAlignment="Top"
                            MinWidth="210"
                            Background="{Binding IsDoneBrush}">

                    <TextBlock Style="{StaticResource SectionHeader}" Text="Diese Zelle" Margin="4,4,4,2" />

                    <TextBlock Text="{Binding DoneStateText}" FontSize="12" Opacity="0.8"
                               TextWrapping="Wrap" Margin="4,0,4,10" />

                    <Button Content="Bewerten …" Command="{Binding OpenResultsCommand}"
                            FontWeight="Bold" Height="38" Background="DarkGreen"
                            ToolTip="Öffnet das Fenster, in dem die Punkte vergeben werden." />

                    <Separator Margin="4,14,4,2" />
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Beenden" Margin="4,0,4,4" />

                    <Button Content="Abschließen" Command="{Binding SaveIsDoneFinishStateCommand}"
                            ToolTip="Speichert und markiert die Zelle als gespielt. Zeigt den Abschlussschritt. Erneut gedrückt holt es ihn zurück auf den Beamer." />
                    <Button Margin="4,6,4,0" Content="Nächster wählt aus" Command="{Binding ExitSetNextChoosingPlayerCommand}"
                            ToolTip="Schließt das Fenster und bestimmt den nächsten Auswählenden." />
                    <Button Margin="4,6,4,0" Content="Gleicher wählt weiter" Command="{Binding ExitCommand}"
                            ToolTip="Schließt das Fenster. Es wählt weiterhin derselbe aus." />

                    <Separator Margin="4,18,4,2" />
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Runde" Margin="4,0,4,4" />

                    <!--
                        Stand bis 2026-09-06 in der Kopfzeile des Buzzers, mit demselben Gewicht
                        wie die Rundenzeile - obwohl es als Einziges hier die Telefone anfasst.
                    -->
                    <Button Content="Runde jetzt schließen"
                            Command="{Binding BuzzerControlsViewModel.CloseRoundCommand}"
                            ToolTip="Wertet mit den bisher eingegangenen Antworten aus, ohne auf fehlende zu warten. Für den Fall, dass ein Telefon ausfällt oder jemand ohne mitspielt." />

                    <Button Content="Runde zurücksetzen"
                            Command="{Binding BuzzerControlsViewModel.ResetRoundCommand}"
                            CommandParameter="{Binding CurrentBuzzerLayout}"
                            ToolTip="Schickt die laufende Runde neu auf die Telefone." />

                    <!-- M37 T4: im Teamspiel buzzert jedes Team einmal je Frage (F-M37-09) - die Spielleitung kann freigeben (E1). -->
                    <StackPanel Visibility="{Binding BuzzerControlsViewModel.TeamSperreVisibility}" Margin="4,10,4,0">
                        <TextBlock Text="{Binding BuzzerControlsViewModel.TeamSperreText}" FontSize="12" TextWrapping="Wrap" Opacity="0.8" />
                        <Button Content="Team wieder freigeben" Command="{Binding BuzzerControlsViewModel.TeamFreigebenCommand}" Margin="0,6,0,0"
                                ToolTip="Wer bei dieser Frage schon gebuzzert hat, darf wieder buzzern – etwa nach einem Versehen. Sonst bleibt das Team bis zum Schließen der Frage gesperrt." />
                    </StackPanel>

                    <!-- M35 B3: der Spielleiter hat die Hand (E1) - starten, wiederholen, abbrechen. -->
                    <StackPanel Visibility="{Binding MinispielSteuerungVisibility}">
                        <Separator Margin="4,18,4,2" />
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Minispiel" Margin="4,0,4,4" />
                        <TextBlock Text="{Binding Reaktion.Kopfzeile}" FontSize="12" Opacity="0.8"
                                   TextWrapping="Wrap" Margin="4,0,4,6" />
                        <TextBlock Text="{Binding Reaktion.Rekord.Text}" Visibility="{Binding Reaktion.RekordVisibility}"
                                   FontWeight="Bold" TextWrapping="Wrap" Margin="4,0,4,6" />
                        <Button Content="Runde starten" Command="{Binding StartMinigameRoundCommand}" FontWeight="Bold"
                                ToolTip="{Binding StartMinigameRoundToolTip}" ToolTipService.ShowOnDisabled="True" />
                        <Button Content="Runde wiederholen" Command="{Binding RepeatMinigameRoundCommand}" Margin="4,6,4,0"
                                ToolTip="{Binding RepeatMinigameRoundToolTip}" ToolTipService.ShowOnDisabled="True" />
                        <Button Content="Minispiel abbrechen" Command="{Binding AbortMinigameCommand}" Margin="4,6,4,0"
                                ToolTip="{Binding AbortMinigameToolTip}" ToolTipService.ShowOnDisabled="True" />

                        <!-- M35 C2: wer spielt - der Ausloeser waehlt am Telefon; fehlt er, waehlt hier der Spielleiter (E1). -->
                        <StackPanel Visibility="{Binding MinispielPaarVisibility}" Margin="4,10,4,0">
                            <TextBlock Text="{Binding PaarWaehlerBeschriftung}" FontSize="12" Margin="0,0,0,2" />
                            <ComboBox ItemsSource="{Binding PaarSpieler}" SelectedItem="{Binding PaarWaehler}"
                                      DisplayMemberPath="CalculatedDisplayName"
                                      ToolTip="Wer das Feld aufgedeckt hat. Er wählt am Telefon sein Gegenüber – fehlt er, hier wählen." />
                            <TextBlock Text="{Binding PaarPartnerBeschriftung}" FontSize="12" Margin="0,6,0,2"
                                       Visibility="{Binding PaarPartnerVisibility}" />
                            <ComboBox ItemsSource="{Binding PaarSpieler}" SelectedItem="{Binding PaarPartner}"
                                      Visibility="{Binding PaarPartnerVisibility}"
                                      DisplayMemberPath="CalculatedDisplayName"
                                      ToolTip="Leer lassen: der Auslöser wählt am Telefon. Gesetzt: der Spielleiter legt fest, wer mitspielt." />
                            <Button Content="{Binding PaarKnopfBeschriftung}" Command="{Binding SetMinigamePairCommand}" Margin="0,6,0,0"
                                    ToolTip="Legt fest, wer spielt. Mitten in der Runde zählt, was schon abgegeben war, nicht mehr." />
                        </StackPanel>
                        <!-- M35 C6: Erklaerbaer - den Begriff sieht nur der Spielleiter, damit er „Verraten" werten kann. -->
                        <StackPanel Visibility="{Binding ErklaerbaerVisibility}" Margin="4,10,4,0">
                            <TextBlock Text="{Binding ErklaerbaerBegriff}" FontWeight="Bold" TextWrapping="Wrap" />
                            <Button Content="Verraten" Command="{Binding VerratenCommand}" Margin="0,6,0,0"
                                    ToolTip="Der Erklärer hat das Wort gesagt: diese Runde bringt niemandem Punkte. Läuft sie noch, endet sie; ist sie vorbei, zählt die letzte nachträglich nicht." />
                        </StackPanel>
                        <!-- M37 T10: Stellvertreter-Duell - waehlt ein Team nicht, lost der Spielleiter (E1). -->
                        <Button Content="Offene Teams auslosen" Command="{Binding DrawProxiesCommand}" Margin="4,10,4,0"
                                Visibility="{Binding StellvertreterLosenVisibility}"
                                ToolTip="Lost für jedes Team, das noch keinen Stellvertreter gewählt hat, einen aus seinen beim Start verbundenen Mitgliedern. Was schon gewählt ist, bleibt; danach beginnt das Duell." />
                        <!-- M37 T11: Staffel - die Spielleitung hat das letzte Wort (E1): Tippfehler gelten lassen, fuer ein fehlendes Telefon weitergeben. -->
                        <Button Content="Antwort gelten lassen" Command="{Binding RelayAcceptCommand}" Margin="4,10,4,0"
                                Visibility="{Binding StaffelGeltenVisibility}"
                                ToolTip="Die zuletzt abgelehnte Antwort zählt doch: Ihr Team bekommt den Teil und läuft weiter. Geht, solange danach niemand geantwortet hat – auch nach dem Ende der Staffel." />
                        <Button Content="Für das Team weitergeben" Command="{Binding RelayPassCommand}" Margin="4,6,4,0"
                                Visibility="{Binding StaffelWeitergebenVisibility}"
                                ToolTip="Das Team am Zug gibt den Teil ab wie nach einem Fehler – etwa wenn das Telefon des Läufers fehlt. Danach ist das nächste Team dran." />
                        <!-- M35 C6: Bluff - zwischen den Phasen streicht der Spielleiter, was der echten Antwort zu nah ist. -->
                        <StackPanel Visibility="{Binding BluffStreichenVisibility}" Margin="4,10,4,0">
                            <TextBlock Text="Bluffs prüfen" FontWeight="Bold" />
                            <TextBlock Text="{Binding BluffEchteAntwort}" TextWrapping="Wrap" Margin="0,2,0,4" />
                            <ItemsControl ItemsSource="{Binding BluffEintraege}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Gestrichen}" IsEnabled="{Binding Aenderbar}" Margin="0,2"
                                                  ToolTip="Angehakt: dieser Bluff steht in Phase 2 nicht zur Wahl und bringt seinem Urheber nichts.">
                                            <TextBlock Text="{Binding Beschriftung}" TextWrapping="Wrap" />
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Angehakt heißt gestrichen. Danach startet „Runde starten“ die Wahl." FontSize="12"
                                       TextWrapping="Wrap" Opacity="0.8" Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- M35 C3: Sonderregel der Zelle - erst die Vorphase am Telefon, dann die Frage. -->
                    <StackPanel Visibility="{Binding Sonderregel.SpielleiterVisibility}">
                        <Separator Margin="4,18,4,2" />
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{Binding Sonderregel.Bereich}" Margin="4,0,4,4" />
                        <TextBlock Text="{Binding Sonderregel.Titel}" FontWeight="Bold" TextWrapping="Wrap" Margin="4,0,4,2" />
                        <TextBlock Text="{Binding Sonderregel.Hinweis}" Visibility="{Binding Sonderregel.HinweisVisibility}"
                                   TextWrapping="Wrap" Margin="4,0,4,2" />
                        <TextBlock Text="{Binding Sonderregel.Stand}" FontSize="12" Opacity="0.8"
                                   TextWrapping="Wrap" Margin="4,0,4,6" />
                        <Button Content="Vorphase schließen" Command="{Binding CloseVorphaseCommand}" FontWeight="Bold"
                                Visibility="{Binding Sonderregel.SchliessenVisibility}"
                                ToolTip="Schließt die Vorphase, auch wenn noch nicht alle abgegeben haben. Für wen nichts kam, gilt die Regel nicht – danach geht die Frage auf die Telefone." />
                        <!-- M37 E4: das Finale deckt der Spielleiter am Beamer einzeln auf, vom Letzten zum Ersten. -->
                        <Button Content="Nächsten auflösen" Command="{Binding FinaleAufloesenCommand}" FontWeight="Bold"
                                Visibility="{Binding FinaleAufloesenVisibility}"
                                ToolTip="Zeigt am Beamer Einsatz und Antwort des Nächsten – vom niedrigsten Stand zum höchsten, im Teamspiel Team für Team. Bewerte danach seine Karte." />
                        <!-- M35 C7b: eine Joker-Sperre hebt der Spielleiter auf (E1). -->
                        <Button Content="Joker-Sperre aufheben" Command="{Binding JokerSperreAufhebenCommand}" Margin="0,6,0,0"
                                Visibility="{Binding JokerSperreVisibility}"
                                ToolTip="Wer per Joker gesperrt ist, darf diese Frage doch beantworten – sein Telefon wird sofort wieder frei." />
                        <!-- M35 C3b: Experte - bei Gleichstand waehlt der Spielleiter unter den Meistgewaehlten (E1). -->
                        <StackPanel Visibility="{Binding SonderregelKandidatVisibility}" Margin="4,6,4,0">
                            <TextBlock Text="Wer antwortet (Gleichstand)" FontSize="12" Margin="0,0,0,2" />
                            <ComboBox ItemsSource="{Binding SonderregelKandidaten}" SelectedItem="{Binding GewaehlterKandidat}"
                                      DisplayMemberPath="CalculatedDisplayName"
                                      ToolTip="Mehrere wurden gleich oft gewählt. Vorgabe ist der erste in der Spielerreihenfolge – hier legst du fest, wer allein antwortet." />
                        </StackPanel>
                        <!-- M37 T6: Gleich gedacht - nach dem Vergleich legt der Spielleiter Gruppen eines Teams zusammen (E1). -->
                        <StackPanel Visibility="{Binding GleichGedachtVisibility}" Margin="4,6,4,0">
                            <TextBlock Text="Gruppen" FontWeight="Bold" />
                            <ItemsControl ItemsSource="{Binding GleichGedachtGruppen}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Markiert}" Margin="0,2"
                                                  ToolTip="Anhaken, um diese Gruppe mit anderen Gruppen desselben Teams zusammenzulegen.">
                                            <TextBlock Text="{Binding Beschriftung}" TextWrapping="Wrap" />
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Angehakte zusammenlegen" Command="{Binding GruppenZusammenlegenCommand}" Margin="0,6,0,0"
                                    ToolTip="Die angehakten Gruppen eines Teams zählen als eine – etwa bei einem Tippfehler. Die erste angehakte gibt den Namen; Karten und Beamer rechnen sofort neu." />
                            <Button Content="Zusammenlegen aufheben" Command="{Binding ZusammenlegenAufhebenCommand}" Margin="0,4,0,0"
                                    ToolTip="Jede Gruppe zählt wieder für sich, wie die Antworten verglichen wurden." />
                        </StackPanel>
                        <!-- M37 T7: Team-Abstimmung - bei Gleichstand wählt der Spielleiter die Antwort des Teams (E1). -->
                        <StackPanel Visibility="{Binding TeamAbstimmungVisibility}" Margin="4,6,4,0">
                            <TextBlock Text="Gleichstand – welche Antwort gilt?" FontWeight="Bold" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding TeamAbstimmungGleichstaende}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Beschriftung}" Margin="0,2" HorizontalContentAlignment="Left"
                                                Command="{Binding DataContext.TeamAntwortWaehlenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Diese Antwort gilt für das Team – auch gegen die Stimme des Sprechers. Karten, Beamer und Telefone rechnen sofort neu." />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>

                    <!-- V5: Countdown auf dem Beamer. Ein Buzzer haelt ihn an. -->
                    <Separator Margin="4,18,4,2" />
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Countdown" Margin="4,0,4,4" />
                    <TextBlock Text="{Binding Countdown.MasterText}" FontSize="12" Opacity="0.8" Margin="4,0,4,6" />
                    <UniformGrid Columns="3" Margin="4,0,4,0">
                        <Button Content="10 s" Command="{Binding StartCountdownCommand}" CommandParameter="10" Margin="0,0,2,0"
                                ToolTip="Zeigt auf dem Beamer einen Countdown über 10 Sekunden. Wer buzzert, hält ihn an." />
                        <Button Content="30 s" Command="{Binding StartCountdownCommand}" CommandParameter="30" Margin="2,0,2,0"
                                ToolTip="Countdown über 30 Sekunden. Wer buzzert, hält ihn an." />
                        <Button Content="60 s" Command="{Binding StartCountdownCommand}" CommandParameter="60" Margin="2,0,0,0"
                                ToolTip="Countdown über eine Minute. Wer buzzert, hält ihn an." />
                    </UniformGrid>
                    <Button Content="Countdown anhalten" Command="{Binding StopCountdownCommand}" Margin="4,6,4,0"
                            ToolTip="Nimmt den Countdown vom Beamer. Angehalten sperrt er nichts." />
                    <!-- M33: nach Ablauf sind die Telefone gesperrt, bis hier freigegeben wird. -->
                    <Button Content="Eingaben wieder erlauben" Command="{Binding BuzzerControlsViewModel.FreigebenCommand}"
                            Visibility="{Binding BuzzerControlsViewModel.FreigabeVisibility}" Margin="4,6,4,0" FontWeight="Bold"
                            ToolTip="Der Countdown ist abgelaufen, die Telefone nehmen nichts mehr an. Das gibt sie wieder frei - auch ein neuer Countdown tut das." />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</base:WindowBase>