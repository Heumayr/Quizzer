<base:WindowBase x:Class="Quizzer.Views.GameViews.QuestionMasterView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Quizzer.Views.GameViews"
        xmlns:base="clr-namespace:Quizzer.Base"
        xmlns:questions="clr-namespace:Quizzer.Views.GameViews.QuestionViews"
        xmlns:buzzerServer="clr-namespace:Quizzer.Views.BuzzerViews"
        xmlns:typed="clr-namespace:Quizzer.Views.GameViews.QuestionViews.Typed"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="800" Width="1300">
    <base:WindowBase.DataContext>
        <local:CurrentQuestionViewModel></local:CurrentQuestionViewModel>
    </base:WindowBase.DataContext>

    <base:WindowBase.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding NextStepCommnad}" />
        <KeyBinding Key="Back" Command="{Binding BackStepCommnad}" />
    </base:WindowBase.InputBindings>

    <Window.Resources>
        <questions:QuestionStepTemplateSelector x:Key="QuestionStepTemplateSelector" />

        <DataTemplate x:Key="DefaultStepTemplate">
            <typed:DefaultStepView IsMasterView="True" />
        </DataTemplate>

        <DataTemplate x:Key="MultipleChoiceStepTemplate">
            <typed:MultipleChoiceStepView IsMasterView="True" />
        </DataTemplate>

        <DataTemplate x:Key="PropertiesStepTemplate">
            <typed:PropertiesStepView IsMasterView="True" />
        </DataTemplate>

        <DataTemplate x:Key="AppreciateStepTemplate">
            <typed:AppreciateStepView IsMasterView="True" />
        </DataTemplate>

        <DataTemplate x:Key="RevealStepTemplate">
            <typed:RevealStepView IsMasterView="True" />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="{Binding BackgroundImagePath}"
             Stretch="UniformToFill" />
        </Grid.Background>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <!-- Kopfleiste: links die Frage, rechts die Angaben, die bisher als neun einzelne
             Textfelder ein Viertel des Fensters belegt haben. -->
        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Background="Black" MaxHeight="110" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Viewbox Grid.Column="0" Margin="5" Stretch="Uniform" HorizontalAlignment="Left">
                <TextBlock Text="{Binding Question.QuestionText}"
                 Foreground="WhiteSmoke"
                 FontWeight="SemiBold"
                 TextWrapping="Wrap"
                 MaxWidth="900"
                 TextAlignment="Left"
                 VerticalAlignment="Center"
                 HorizontalAlignment="Center" />
            </Viewbox>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,4,12,4">
                <TextBlock Text="{Binding QuestionSummary}" FontWeight="Bold" FontSize="14"
                           Foreground="Wheat" TextAlignment="Right" />
                <TextBlock Text="{Binding QuestionNotesLine}" FontSize="12" Opacity="0.75"
                           TextAlignment="Right" TextWrapping="Wrap" MaxWidth="320"
                           Visibility="{Binding NotesVisibility}" />
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Grid.Column="0" BorderThickness="3" BorderBrush="Black">
            <Grid  MinWidth="200" ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Border Width="4" Background="Wheat" Margin="0,0,6,0" />
                    <TextBlock Text="Jetzt sichtbar" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Text=" (läuft auf dem Beamer)" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                </StackPanel>
                <ContentControl Grid.Row="1"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Stretch"
                      Content="{Binding CurrentStepContext}"
                      ContentTemplateSelector="{StaticResource QuestionStepTemplateSelector}" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" BorderThickness="3" BorderBrush="Black">
            <Grid MinWidth="200"  ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Als Nächstes" FontWeight="Bold" FontSize="14" Margin="10,0,0,0" />
                <ContentControl Grid.Row="1"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch"
                  VerticalContentAlignment="Stretch"
                  Content="{Binding NextStepContext}"
                  ContentTemplateSelector="{StaticResource QuestionStepTemplateSelector}" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Grid.Column="0" BorderThickness="3" BorderBrush="Black">
            <Grid  MinWidth="200" ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Abschluss" FontWeight="Bold" FontSize="14" Margin="10,0,0,0" />
                <ContentControl Grid.Row="1"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch"
                     HorizontalContentAlignment="Stretch"
                     VerticalContentAlignment="Stretch"
                     Content="{Binding FinishStepContext}"
                     ContentTemplateSelector="{StaticResource QuestionStepTemplateSelector}" />
            </Grid>
        </Border>

        <Border Background="Black" Grid.Row="2" Grid.Column="1" BorderThickness="3" BorderBrush="Black">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="auto"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Grid.Column="0">
                    <Border BorderBrush="WhiteSmoke">
                        <buzzerServer:BuzzerControlsView DataContext="{Binding BuzzerControlsViewModel}" />
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Grid.Column="0">
                    <questions:CurrentQuestionView />
                </Grid>

                <!--
                    Ueber beide Zeilen, damit die Spielerliste links die Knopfspalte nicht nach
                    unten schiebt. Gemessen am 2026-09-06: vorher stand sie in Zeile 1 und rutschte
                    bei zehn Mitspielern 49 Punkte aus dem Fenster - die beiden untersten Knoepfe
                    waren nicht mehr da.
                -->
                <!--
                    Die Handlungsspalte. Alle sechs Aenderungen vom 2026-09-06 stecken hier
                    (Nutzerentscheidung F10):
                      1  zwei Gruppen statt einer Liste, mit Trennung dazwischen
                      2  eine einzige hervorgehobene Taste - "Bewerten" kommt bei jeder Zelle
                      3  Beschriftungen nach dem Ergebnis statt nach der Mechanik
                      4  die Ueberschrift heisst nicht mehr wie einer der Knoepfe
                      5  der Zustand steht oben, vor der Entscheidung, nicht darunter
                      6  der Neustart der Runde hat eine eigene Gruppe - er ist das Einzige hier,
                         das die Telefone anfasst
                -->
                <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" VerticalAlignment="Top"
                            MinWidth="210"
                            Background="{Binding IsDoneBrush}">

                    <TextBlock Style="{StaticResource SectionHeader}" Text="Diese Zelle" Margin="4,4,4,2" />

                    <TextBlock Text="{Binding DoneStateText}" FontSize="12" Opacity="0.8"
                               TextWrapping="Wrap" Margin="4,0,4,10" />

                    <Button Content="Bewerten …" Command="{Binding OpenResultsCommand}"
                            FontWeight="Bold" Height="38" Background="DarkGreen"
                            ToolTip="Öffnet das Fenster, in dem die Punkte vergeben werden." />

                    <Separator Margin="4,14,4,2" />
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Beenden" Margin="4,0,4,4" />

                    <Button Content="Abschließen" Command="{Binding SaveIsDoneFinishStateCommand}"
                            ToolTip="Speichert und markiert die Zelle als gespielt. Zeigt den Abschlussschritt. Erneut gedrückt holt es ihn zurück auf den Beamer." />
                    <Button Margin="0,6,0,0" Content="Nächster wählt aus" Command="{Binding ExitSetNextChoosingPlayerCommand}"
                            ToolTip="Schließt das Fenster und bestimmt den nächsten Auswählenden." />
                    <Button Margin="0,6,0,0" Content="Gleicher wählt weiter" Command="{Binding ExitCommand}"
                            ToolTip="Schließt das Fenster. Es wählt weiterhin derselbe aus." />

                    <Separator Margin="4,18,4,2" />
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Runde" Margin="4,0,4,4" />

                    <!--
                        Stand bis 2026-09-06 in der Kopfzeile des Buzzers, mit demselben Gewicht
                        wie die Rundenzeile - obwohl es als Einziges hier die Telefone anfasst.
                    -->
                    <Button Content="Runde zurücksetzen"
                            Command="{Binding BuzzerControlsViewModel.ResetRoundCommand}"
                            CommandParameter="{Binding CurrentBuzzerLayout}"
                            ToolTip="Schickt die laufende Runde neu auf die Telefone." />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</base:WindowBase>