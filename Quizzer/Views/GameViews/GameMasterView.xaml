<base:WindowBase x:Class="Quizzer.Views.GameViews.GameMasterView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Quizzer.Views.GameViews"
        xmlns:sub="clr-namespace:Quizzer.Views.GameViews.Sub"
        xmlns:base="clr-namespace:Quizzer.Base"
        xmlns:helper="clr-namespace:Quizzer.Views.HelperViewModels"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="700" Width="1200">
    <base:WindowBase.DataContext>
        <local:GameMasterViewModel />
    </base:WindowBase.DataContext>
    <base:WindowBase.Resources>
        <ItemsPanelTemplate x:Key="MatrixPanel">
            <Grid
                base:MatrixGridBehavior.Rows="{Binding DataContext.Height, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                base:MatrixGridBehavior.Columns="{Binding DataContext.Width, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                base:MatrixGridBehavior.CellWidth="{Binding DataContext.CellWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                base:MatrixGridBehavior.CellHeight="{Binding DataContext.CellHeight, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
        </ItemsPanelTemplate>
    </base:WindowBase.Resources>
    <Grid Background="{Binding PlayGroundBackGroundBrush}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="4*" />
            <RowDefinition Height="{Binding StatsRowHeight}" />
        </Grid.RowDefinitions>
        <!-- Linke Spalte: vier abgesetzte Bloecke statt einer Knopfkette. Jeder Block sagt in
             seiner Ueberschrift, worum es geht, und die Knoepfe sagen, was ein Druck bewirkt. -->
        <Border Padding="16" Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Background="Black" Width="250">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Vertical">

                    <!-- Spielstand -->
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Spielstand" />
                    <TextBlock FontSize="20" FontWeight="Bold" Text="{Binding ProgressHeadline}" />
                    <TextBlock Opacity="0.75" Text="{Binding OpenCellsText}" Margin="0,2,0,0" />

                    <!-- Wer waehlt aus -->
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Wer wählt aus" Margin="0,18,0,4" />
                    <TextBlock TextWrapping="Wrap" FontWeight="ExtraBold" FontSize="18"
                               Text="{Binding ChoosingPlayer}" TextAlignment="Center"
                               Foreground="Wheat" />

                    <!-- Phase -->
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Phase" Margin="0,18,0,4" />
                    <TextBlock FontSize="16" FontWeight="Bold" Text="{Binding PhaseHeadline}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="Phase +" Command="{Binding RaiseGamePhaseCommand}"
                                ToolTip="Erhöht die Phase. Die Punkte aller noch offenen Zellen steigen." />
                        <Button Content="Phase −" Command="{Binding LowerGamePhaseCommand}"
                                ToolTip="Senkt die Phase. Die Punkte aller noch offenen Zellen sinken." />
                    </StackPanel>
                    <TextBlock Opacity="0.65" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"
                               Text="Ändert die Punkte aller noch offenen Zellen." />

                    <!-- Fenster und Anzeige, getrennt nach Wirkungsort -->
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Bei den Spielern" Margin="0,18,0,4" />
                    <Button Content="Spieleransicht öffnen" Command="{Binding OpenGamePlayerViewCommand}"
                            ToolTip="Öffnet das Fenster für den Beamer. Ist es schon offen, kommt es nach vorne." />
                    <Button Content="{Binding ToggleStatsButtonText}" Command="{Binding TogglePlayerStatsViewCommand}"
                            ToolTip="Blendet den Punktestand auf dem Spielerbildschirm ein oder aus." />

                    <TextBlock Style="{StaticResource SectionHeader}" Text="Bei mir" Margin="0,18,0,4" />
                    <Button Content="Vollbild umschalten" Command="{Binding ToggleFullScreenCommand}" />
                    <Button Content="Zwischen Raster und Punkten wechseln" Command="{Binding ChangeViewCommand}" />

                    <TextBlock Style="{StaticResource SectionHeader}" Text="Telefone" Margin="0,18,0,4" />
                    <Button Content="Buzzer-Server öffnen" Command="{Binding BuzzerServerCommand}"
                            ToolTip="Startet den Server, zu dem sich die Telefone verbinden, und zeigt die QR-Codes." />
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Viewbox Margin="5" Grid.Column="1" Grid.Row="0"
              Stretch="Uniform"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch">
            <Grid>
                <!-- Column headers -->
                <ItemsControl ItemsSource="{Binding ColumnHeaderVMs}" ItemsPanel="{StaticResource MatrixPanel}">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Grid.Row" Value="{Binding GridRow}" />
                            <Setter Property="Grid.Column" Value="{Binding GridColumn}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="2"
                                    Background="{Binding DataContext.HeaderColumnBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    SnapsToDevicePixels="True"
                                    Margin="3">
                                <TextBox IsReadOnly="{Binding LockHeader}"
                                         Text="{Binding TextLong, Mode=OneWay}"
                                         Background="Transparent"
                                         Foreground="WhiteSmoke"
                                         BorderThickness="0"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         TextAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Stretch"
                                         Padding="4"
                                         HorizontalScrollBarVisibility="Disabled"
                                         VerticalScrollBarVisibility="Disabled"
                                         base:AutoFitTextBox.IsEnabled="True"
                                         base:AutoFitTextBox.MinFontSize="6"
                                         base:AutoFitTextBox.MaxFontSize="22" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Row headers -->
                <ItemsControl ItemsSource="{Binding RowHeaderVMs}" ItemsPanel="{StaticResource MatrixPanel}">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Grid.Row" Value="{Binding GridRow}" />
                            <Setter Property="Grid.Column" Value="{Binding GridColumn}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="2"
                                    Background="{Binding DataContext.HeaderRowBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    SnapsToDevicePixels="True"
                                    Margin="3">
                                <TextBox IsReadOnly="{Binding LockHeader}"
                                        Text="{Binding TextLong, Mode=OneWay}"
                                        Background="Transparent"
                                        Foreground="WhiteSmoke"
                                        BorderThickness="0"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        TextAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Padding="4"
                                        HorizontalScrollBarVisibility="Disabled"
                                        VerticalScrollBarVisibility="Disabled"
                                        base:AutoFitTextBox.IsEnabled="True"
                                        base:AutoFitTextBox.MinFontSize="6"
                                        base:AutoFitTextBox.MaxFontSize="22" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Cells -->
                <ItemsControl ItemsSource="{Binding CellVMs}" ItemsPanel="{StaticResource MatrixPanel}">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Grid.Row" Value="{Binding GridRow}" />
                            <Setter Property="Grid.Column" Value="{Binding GridColumn}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <helper:UcCellViewPlay
                                Command="{Binding DataContext.CellClickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                Margin="2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Viewbox>

        <Viewbox Grid.Row="1" Grid.Column="1">
            <sub:UcStatsView DataContext="{Binding StatsContext}" />
        </Viewbox>
    </Grid>
</base:WindowBase>