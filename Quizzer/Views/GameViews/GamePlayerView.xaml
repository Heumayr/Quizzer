<base:WindowBase x:Class="Quizzer.Views.GameViews.GamePlayerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Quizzer.Views.GameViews"
        xmlns:base="clr-namespace:Quizzer.Base"
        xmlns:helper="clr-namespace:Quizzer.Views.HelperViewModels"
        xmlns:typed="clr-namespace:Quizzer.Views.GameViews.QuestionViews.Typed"
        xmlns:questions="clr-namespace:Quizzer.Views.GameViews.QuestionViews"
        xmlns:sub="clr-namespace:Quizzer.Views.GameViews.Sub"
        mc:Ignorable="d"
        Title="Spieleransicht (Beamer)" Height="450" Width="800">
    <base:WindowBase.DataContext>
        <local:GamePlayerViewModel></local:GamePlayerViewModel>
    </base:WindowBase.DataContext>
    <base:WindowBase.Resources>
        <ItemsPanelTemplate x:Key="MatrixPanel">
            <Grid
             base:MatrixGridBehavior.Rows="{Binding DataContext.Height, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
             base:MatrixGridBehavior.Columns="{Binding DataContext.Width, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
             base:MatrixGridBehavior.CellWidth="{Binding DataContext.CellWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
             base:MatrixGridBehavior.CellHeight="{Binding DataContext.CellHeight, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
        </ItemsPanelTemplate>

        <questions:QuestionStepTemplateSelector x:Key="QuestionStepTemplateSelector" />

        <DataTemplate x:Key="DefaultStepTemplate">
            <typed:DefaultStepView IsMasterView="False" />
        </DataTemplate>

        <DataTemplate x:Key="MultipleChoiceStepTemplate">
            <typed:MultipleChoiceStepView IsMasterView="False" />
        </DataTemplate>

        <DataTemplate x:Key="PropertiesStepTemplate">
            <typed:PropertiesStepView IsMasterView="False" />
        </DataTemplate>

        <DataTemplate x:Key="AppreciateStepTemplate">
            <typed:AppreciateStepView IsMasterView="False" />
        </DataTemplate>

        <base:BottomStatsRowHeightConverter x:Key="BottomStatsRowHeightConverter" />
        <base:MainContentRowHeightConverter x:Key="MainContentRowHeightConverter" />
    </base:WindowBase.Resources>
    <Grid Background="{Binding PlayGroundBackGroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="{Binding ShowBottomStats, Converter={StaticResource MainContentRowHeightConverter}}" />
            <RowDefinition Height="{Binding ShowBottomStats, Converter={StaticResource BottomStatsRowHeightConverter}}" />
        </Grid.RowDefinitions>
        <!-- Links: dieselben Wandler wie fuer die Zeilen - 1 zu 4, oder ganz weg. -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding ShowLeftStats, Converter={StaticResource BottomStatsRowHeightConverter}}" />
            <ColumnDefinition Width="{Binding ShowLeftStats, Converter={StaticResource MainContentRowHeightConverter}}" />
        </Grid.ColumnDefinitions>

        <!-- MAIN AREA -->
        <Grid Grid.Row="0" Grid.Column="1" Visibility="{Binding ShowMainContent}">
            <!-- Zurueck zum Raster: ruhig einblenden, kein Schwung - der Blick sucht die naechste Zelle -->
            <Viewbox Visibility="{Binding ShowGameGridView}" Margin="5"
                 base:Bewegung.Einblenden="True" base:Bewegung.Stil="Blenden"
                 Stretch="Uniform"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Stretch">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Column headers -->
                    <ItemsControl ItemsSource="{Binding ColumnHeaderVMs}" ItemsPanel="{StaticResource MatrixPanel}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Grid.Row" Value="{Binding GridRow}" />
                                <Setter Property="Grid.Column" Value="{Binding GridColumn}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="2"
                                    Background="{Binding DataContext.HeaderColumnBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    SnapsToDevicePixels="True"
                                    Margin="3">
                                    <TextBox IsReadOnly="{Binding LockHeader}"
                                         Text="{Binding TextLong, Mode=OneWay}"
                                         Background="Transparent"
                                         Foreground="WhiteSmoke"
                                         BorderThickness="0"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         TextAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Stretch"
                                         Padding="4"
                                         HorizontalScrollBarVisibility="Disabled"
                                         VerticalScrollBarVisibility="Disabled"
                                         base:AutoFitTextBox.IsEnabled="True"
                                         base:AutoFitTextBox.MinFontSize="6"
                                         base:AutoFitTextBox.MaxFontSize="22" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Row headers -->
                    <ItemsControl ItemsSource="{Binding RowHeaderVMs}" ItemsPanel="{StaticResource MatrixPanel}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Grid.Row" Value="{Binding GridRow}" />
                                <Setter Property="Grid.Column" Value="{Binding GridColumn}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="2"
                                    Background="{Binding DataContext.HeaderRowBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    SnapsToDevicePixels="True"
                                    Margin="3">
                                    <TextBox IsReadOnly="{Binding LockHeader}"
                                         Text="{Binding TextLong, Mode=OneWay}"
                                         Background="Transparent"
                                         Foreground="WhiteSmoke"
                                         BorderThickness="0"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         TextAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Stretch"
                                         Padding="4"
                                         HorizontalScrollBarVisibility="Disabled"
                                         VerticalScrollBarVisibility="Disabled"
                                         base:AutoFitTextBox.IsEnabled="True"
                                         base:AutoFitTextBox.MinFontSize="6"
                                         base:AutoFitTextBox.MaxFontSize="22" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Cells -->
                    <ItemsControl ItemsSource="{Binding CellVMs}" ItemsPanel="{StaticResource MatrixPanel}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Grid.Row" Value="{Binding GridRow}" />
                                <Setter Property="Grid.Column" Value="{Binding GridColumn}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Ohne Command: das Beamer-Fenster ist eine Anzeige, ausgewaehlt
                                     wird im Spielleiter-Fenster. Die Bindung zeigte auf
                                     CellClickCommand, das es auf dem GamePlayerViewModel gar nicht
                                     gibt - eine tote Bindung, gemessen 2026-09-06. -->
                                <helper:UcCellViewPlay Margin="2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Viewbox>

            <!-- Die Frageanzeige liegt in QuestionScreenView, damit die Vorschau im
                 Frageneditor dieselbe benutzt und nicht daneben etwas Eigenes zeichnet. -->
            <local:QuestionScreenView Visibility="{Binding ShowQuestionView}"
                                      base:Bewegung.Einblenden="True" base:Bewegung.Stil="Zoomen" />
        </Grid>

        <!-- BOTTOM STATS -->
        <!-- Ohne Viewbox: die Punktekacheln fuellen die Leiste selbst aus. Eine Viewbox hier
             hat den ganzen Streifen auf die Groesse einer einzelnen Karte gestaucht - die
             Punktzahl kam mit rund 14 Bildpunkten auf dem Beamer an.
             Dunkler Grund, damit der Kontrast nicht vom Hintergrundbild abhaengt. -->
        <Border Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Visibility="{Binding ShowBottomStats}"
            Background="#99000000"
            Margin="5">
            <sub:UcStatsView DataContext="{Binding StatsContext}" />
        </Border>

        <!-- LEFT STATS: dieselben Kacheln untereinander, je Spieler eine Zeile -->
        <Border Grid.Row="0"
            Grid.Column="0"
            Visibility="{Binding ShowLeftStats}"
            Background="#99000000"
            Margin="5">
            <ItemsControl DataContext="{Binding StatsContext}"
                          ItemsSource="{Binding PlayerStatsContextList}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <sub:UcPlayerScoreTile MaxHeight="220" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- FULLSCREEN STATS -->
        <Grid Grid.Row="0"
          Grid.RowSpan="2"
          Grid.Column="0"
          Grid.ColumnSpan="2"
          Visibility="{Binding ShowFullscreenStats}">
            <Viewbox Stretch="Uniform">
                <sub:UcStatsView DataContext="{Binding StatsContext}" />
            </Viewbox>
        </Grid>

        <!-- V5: COUNTDOWN oben rechts, ueber Raster und Frage. Rot in den letzten Sekunden. -->
        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2"
                DataContext="{Binding Countdown}"
                Visibility="{Binding Visibility, FallbackValue=Collapsed}"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,24,24,0"
                MinWidth="220" Padding="28,10,28,14" CornerRadius="18"
                BorderThickness="3" IsHitTestVisible="False" Panel.ZIndex="950"
                base:Bewegung.Einblenden="True" base:Bewegung.Stil="Zoomen">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#E6101010" />
                    <Setter Property="BorderBrush" Value="WhiteSmoke" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Knapp}" Value="True">
                            <Setter Property="Background" Value="#E6801010" />
                            <Setter Property="BorderBrush" Value="#FFFF8A80" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="{Binding Text}" FontSize="96" FontWeight="Bold" Foreground="WhiteSmoke"
                           HorizontalAlignment="Center" FontFamily="Segoe UI" />
                <!-- Der Balken schrumpft von rechts nach links; nur Skalierung, kein Layout. -->
                <Border Height="10" CornerRadius="5" Background="#33FFFFFF" Margin="0,4,0,0">
                    <Border CornerRadius="5" Background="WhiteSmoke" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="{Binding Anteil}" />
                        </Border.RenderTransform>
                    </Border>
                </Border>
            </StackPanel>
        </Border>

        <!-- PUNKTE DIESER FRAGE: nur wenn die Leiste ausgeblendet ist (2026-10-21). Faehrt
             vergroessert ein, steht einige Sekunden und blendet aus. -->
        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2"
                DataContext="{Binding StatsContext}"
                Visibility="{Binding AenderungenVisibility}"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                MinWidth="520" Padding="36,24" CornerRadius="18"
                Background="#E6101010" BorderBrush="WhiteSmoke" BorderThickness="2"
                IsHitTestVisible="False" Panel.ZIndex="900"
                base:Bewegung.Einblenden="True" base:Bewegung.Stil="Zoomen">
            <StackPanel>
                <TextBlock Text="Punkte dieser Frage" FontSize="34" FontWeight="Bold"
                           Foreground="Wheat" HorizontalAlignment="Center" Margin="0,0,0,16" />
                <ItemsControl ItemsSource="{Binding Aenderungen}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding PlayerName}" FontSize="38" FontWeight="SemiBold"
                                           Foreground="WhiteSmoke" Margin="0,0,32,0" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Background="{Binding WechselBrush}" CornerRadius="12"
                                        Padding="14,2" Margin="0,0,24,0">
                                    <TextBlock Text="{Binding WechselText}" FontSize="38" FontWeight="ExtraBold"
                                               Foreground="White" />
                                </Border>
                                <TextBlock Grid.Column="2" Text="{Binding AnzeigePunkte}" FontSize="38"
                                           FontWeight="ExtraBold" Foreground="WhiteSmoke" VerticalAlignment="Center"
                                           MinWidth="110" TextAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- CURRENT BUZZER PLAYER OVERLAY -->
        <!--<Grid Grid.RowSpan="2"
              Panel.ZIndex="999"
              IsHitTestVisible="False">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="30,16"
                    CornerRadius="10"
                    Background="#AA000000"
                    BorderBrush="WhiteSmoke"
                    BorderThickness="2">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentBuzzerWinner}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Viewbox Stretch="Uniform">
                    <TextBlock Text="{Binding CurrentBuzzerPlayer.DisplayName}"
                               Foreground="WhiteSmoke"
                               FontWeight="Bold"
                               TextAlignment="Center"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                </Viewbox>
            </Border>
        </Grid>-->
    </Grid>
</base:WindowBase>