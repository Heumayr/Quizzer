<base:WindowBase x:Class="Quizzer.Views.HelperViewModels.QuestionSelectorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Quizzer.Views.HelperViewModels"
        xmlns:base="clr-namespace:Quizzer.Base"
        mc:Ignorable="d"
        Title="Frage auswählen" Height="500" Width="900">
    <base:WindowBase.DataContext>
        <local:QuestionSelectorViewModel />
    </base:WindowBase.DataContext>
    <Grid Background="Black">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Margin="5">
            <Button Content="Schließen"
                    ToolTip="Schließt die Auswahl, ohne die Zuweisung zu ändern." Command="{Binding CloseCommand}" />
        </StackPanel>

        <StackPanel Grid.Column="1">
            <StackPanel Orientation="Horizontal" Margin="5">
                <Button Content="Neue Frage"
                        ToolTip="Legt eine neue Frage an und weist sie dieser Zelle gleich zu." Command="{Binding AddQuestionCommand}" />
                <Button Content="Ausgewählte bearbeiten"
                        ToolTip="Öffnet die gewählte Frage im Frageneditor." Command="{Binding EditSelectedQuestionCommand}" />
                <Label MinWidth="120" Margin="10,0,0,0" Content="Ausgewählte Frage:" />
                <Label Content="{Binding Path=CurrentSelectedQuestionDisplay}" MinWidth="200" Margin="5,0,0,0" />
                <Button Content="Auswahl entfernen"
                        ToolTip="Nimmt die Frage von dieser Zelle. Die Zelle bleibt leer, die Frage bleibt bestehen." Command="{Binding DeselectCommand}" Style="{StaticResource DangerButton}" />
            </StackPanel>
            <DataGrid ItemsSource="{Binding AvailableQuestions}" AutoGenerateColumns="False" Margin="5" CanUserAddRows="False" SelectionMode="Single" IsReadOnly="True" SelectedItem="{Binding SelectedQuestion}"
                        base:DataGridRowDoubleClickBehavior.DoubleClickCommand="{Binding SelectAndCloseCommand}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Bezeichnung" Binding="{Binding Designation}" Width="2*" />
                    <DataGridTextColumn Header="Kategorie" Binding="{Binding Category.Designation}" Width="*" />
                    <DataGridTextColumn Header="Schwierigkeit" Binding="{Binding Difficulty}" Width="*" />
                    <DataGridTextColumn Header="Punkte" Binding="{Binding Points}" Width="*" />
                    <DataGridTextColumn Header="Minuspunkte" Binding="{Binding MinusPoints}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Grid>
</base:WindowBase>