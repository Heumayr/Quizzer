<base:WindowBase x:Class="Quizzer.Views.HelperViewModels.PromptView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:base="clr-namespace:Quizzer.Base"
        xmlns:local="clr-namespace:Quizzer.Views.HelperViewModels"
        Title="{Binding Caption}" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <base:WindowBase.DataContext>
        <local:PromptViewModel />
    </base:WindowBase.DataContext>

    <!-- M29: Meldungen, Fragen und Fehler im Design der App statt im weißen Windows-Fenster. -->
    <Grid Background="{StaticResource AppBgBrush}" Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Width="44" Height="44" CornerRadius="22" BorderThickness="2"
                BorderBrush="{Binding AccentBrush}" Margin="0,2,16,0" VerticalAlignment="Top">
            <TextBlock Text="{Binding Symbol}" Foreground="{Binding AccentBrush}" FontSize="22" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <StackPanel Grid.Row="0" Grid.Column="1">
            <TextBlock Text="{Binding Heading}" Foreground="{Binding AccentBrush}" FontWeight="Bold" FontSize="13" />
            <TextBlock x:Name="Meldungstext" Text="{Binding Message}" TextWrapping="Wrap" FontSize="14" Margin="0,6,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="1" Visibility="{Binding DetailsVisibility}" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="EinzelheitenKnopf" Content="Einzelheiten zeigen" Click="Einzelheiten_Click" Padding="10,3"
                        ToolTip="Zeigt die technische Beschreibung des Fehlers - zum Weitergeben, wenn er sich wiederholt." />
                <Button Content="In die Zwischenablage" Click="Kopieren_Click" Padding="10,3" Margin="8,0,0,0"
                        ToolTip="Kopiert Meldung und technische Beschreibung, etwa zum Einfügen in eine Nachricht." />
            </StackPanel>
            <TextBox x:Name="Einzelheiten" Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" Visibility="Collapsed"
                     TextWrapping="NoWrap" FontFamily="Consolas" FontSize="11" MaxHeight="240" Margin="0,8,0,0"
                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="Nein" Click="Nein_Click" IsCancel="True" Visibility="{Binding SecondaryVisibility}"
                    MinWidth="110" Height="34" Margin="0,0,8,0"
                    ToolTip="Verneint die Frage - es geschieht nichts. Escape wirkt genauso." />
            <Button x:Name="Hauptknopf" Content="{Binding PrimaryText}" Click="Haupt_Click" IsDefault="True"
                    MinWidth="130" Height="34" FontWeight="Bold" ToolTip="{Binding PrimaryToolTip}" />
        </StackPanel>
    </Grid>
</base:WindowBase>
