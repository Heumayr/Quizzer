<base:WindowBase x:Class="Quizzer.Views.CategoriesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:base="clr-namespace:Quizzer.Base"
        xmlns:local="clr-namespace:Quizzer.Views"
        mc:Ignorable="d"
        Title="Kategorien" Height="450" Width="800">
    <base:WindowBase.DataContext>
        <local:CategoriesViewModel />
    </base:WindowBase.DataContext>
    <Grid Background="{StaticResource AppBgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Margin="5" Width="200">
            <Button Content="Speichern" Command="{Binding SaveCommand}" MinWidth="150" Height="32"
                    ToolTip="Schreibt alle Zeilen der Liste, auch die neu angelegten." />

            <TextBlock TextWrapping="Wrap" Opacity="0.75" FontSize="12" Margin="0,12,0,0"
                       Text="Neue Kategorie: in die letzte, leere Zeile tippen. Umbenennen geht in der Zeile selbst." />

            <!--
                Die Entf-Taste raeumte die Zeile bis 2026-09-07 aus der Liste, und das Speichern
                schrieb nur die verbliebenen - die Kategorie blieb in der Datenbank. Es sah aus
                wie ein Loeschen und war keins.
            -->
            <TextBlock TextWrapping="Wrap" Opacity="0.75" FontSize="12" Margin="0,12,0,0"
                       Text="Kategorien lassen sich hier nicht entfernen. Mit einer Kategorie verschwänden alle Fragen darin, samt ihren Schritten und den Punkten, die damit gespielt wurden." />
        </StackPanel>

        <DataGrid Grid.Column="1" ItemsSource="{Binding Categories}" AutoGenerateColumns="False" Margin="5"
                  CanUserAddRows="True" CanUserDeleteRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Bezeichnung" Binding="{Binding Designation}" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</base:WindowBase>