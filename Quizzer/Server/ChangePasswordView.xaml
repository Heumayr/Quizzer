<base:WindowBase x:Class="Quizzer.Server.ChangePasswordView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:base="clr-namespace:Quizzer.Base"
        xmlns:local="clr-namespace:Quizzer.Server"
        Title="Kennwort ändern" Height="400" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <base:WindowBase.DataContext>
        <local:ChangePasswordViewModel />
    </base:WindowBase.DataContext>

    <StackPanel Background="{StaticResource AppBgBrush}" Margin="24">
        <TextBlock Text="Bisheriges Kennwort" Style="{StaticResource SectionHeader}" />
        <PasswordBox x:Name="Bisher" PasswordChanged="Changed" Height="32" />

        <TextBlock Text="Neues Kennwort" Style="{StaticResource SectionHeader}" Margin="0,12,0,0" />
        <PasswordBox x:Name="Neu" PasswordChanged="Changed" Height="32" />

        <TextBlock Text="Neues Kennwort wiederholen" Style="{StaticResource SectionHeader}" Margin="0,12,0,0" />
        <PasswordBox x:Name="Wiederholt" PasswordChanged="Changed" Height="32" />

        <TextBlock Text="Mindestens 12 Zeichen. Ein langer Satz ist besser als ein kurzes Wort mit Sonderzeichen."
                   FontSize="12" Opacity="0.75" TextWrapping="Wrap" Margin="0,8,0,0" />

        <TextBlock Text="{Binding Message}" Foreground="#FF8A80" TextWrapping="Wrap" Margin="0,8,0,0" />

        <Button Content="Ändern" Command="{Binding SaveCommand}" IsDefault="True" HorizontalAlignment="Right"
                MinWidth="140" Height="34" FontWeight="Bold" Margin="0,12,0,0"
                ToolTip="Ändert das Kennwort am Server." />
    </StackPanel>
</base:WindowBase>
