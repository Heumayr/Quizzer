<base:WindowBase x:Class="Quizzer.Server.KiEinstellungenView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:base="clr-namespace:Quizzer.Base"
        xmlns:local="clr-namespace:Quizzer.Server"
        Title="KI einrichten" Height="680" Width="900"
        WindowStartupLocation="CenterOwner">
    <base:WindowBase.DataContext>
        <local:KiEinstellungenViewModel />
    </base:WindowBase.DataContext>

    <base:WindowBase.Resources>
        <Style x:Key="Feld" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.8" />
            <Setter Property="Margin" Value="0,10,0,2" />
        </Style>
    </base:WindowBase.Resources>

    <Grid Background="{StaticResource AppBgBrush}" Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
            <StackPanel>
                <TextBlock Text="Anbieter" Style="{StaticResource SectionHeader}" />
                <ComboBox ItemsSource="{Binding AnbieterListe}" SelectedItem="{Binding Anbieter}" DisplayMemberPath="Name" Height="30" />
                <TextBlock Text="{Binding Hilfe}" TextWrapping="Wrap" Opacity="0.75" Margin="0,6,0,0" />

                <StackPanel Visibility="{Binding AdresseVisibility}">
                    <TextBlock Text="Adresse (bei Claude leer)" Style="{StaticResource Feld}" />
                    <TextBox Text="{Binding Adresse, UpdateSourceTrigger=PropertyChanged}" Height="30" VerticalContentAlignment="Center" />

                    <TextBlock Text="Modell" Style="{StaticResource Feld}" />
                    <TextBox Text="{Binding Modell, UpdateSourceTrigger=PropertyChanged}" Height="30" VerticalContentAlignment="Center"
                             ToolTip="Claude: claude-opus-5-5 (Vorgabe). Ollama: der Name aus „ollama list“, etwa llama3.1 - für Bilder ein Modell mit Bildverständnis." />

                    <TextBlock Text="API-Schlüssel" Style="{StaticResource Feld}" />
                    <PasswordBox x:Name="Schluessel" PasswordChanged="SchluesselGeaendert" Height="30"
                                 ToolTip="Leer lassen heißt: der hinterlegte bleibt. Er wird verschlüsselt am Server abgelegt und nie wieder angezeigt." />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding SchluesselStand}" Opacity="0.75" VerticalAlignment="Center" />
                        <CheckBox Content="hinterlegten Schlüssel löschen" IsChecked="{Binding SchluesselLoeschen}" Margin="16,0,0,0" />
                    </StackPanel>

                    <TextBlock Text="Tageslimit je Konto (Aufrufe)" Style="{StaticResource Feld}" />
                    <TextBox Text="{Binding Tageslimit, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left" Height="30" VerticalContentAlignment="Center"
                             ToolTip="Ein Aufruf liefert bis zu fünf Entwürfe. Gescheiterte Aufrufe zählen nicht." />

                    <CheckBox Content="Links abrufen (der Server holt die Seiten; nur öffentliche Adressen)" IsChecked="{Binding LinksAbrufen}" Margin="0,12,0,0"
                              ToolTip="Ohne Haken müssen Inhalte als Text eingefügt werden. Adressen im eigenen Netz werden nie abgerufen." />
                </StackPanel>

                <Border Background="{StaticResource PanelBgBrush}" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,16,0,0">
                    <TextBlock TextWrapping="Wrap" Opacity="0.85"
                               Text="Datenschutz: Bei einem externen Anbieter (Claude, OpenAI) gehen Thema, eingefügter Text, der Inhalt abgerufener Links und Bilder an ihn. Eine lokale KI (Ollama im selben Netz) behält alles im Haus. Gespeichert wird am Server nichts davon - nur die Einstellungen und ein Zähler je Konto und Tag." />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Column="1" Grid.Row="0">
            <TextBlock DockPanel.Dock="Top" Text="Wer darf KI-Entwürfe?" Style="{StaticResource SectionHeader}" />
            <TextBlock DockPanel.Dock="Top" Text="Admins dürfen immer." Opacity="0.75" Margin="0,0,0,6" />
            <ListBox ItemsSource="{Binding Konten}" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Name}" IsChecked="{Binding Frei}" IsEnabled="{Binding Aenderbar}" Margin="0,2" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Speichern und testen" Command="{Binding ProbeCommand}" MinWidth="170" Margin="0,0,8,0"
                        ToolTip="Speichert und lässt die KI einen kleinen Entwurf schreiben. Zählt nicht aufs Tageslimit." />
                <Button Content="Speichern" Command="{Binding SaveCommand}" MinWidth="120" FontWeight="Bold" />
            </StackPanel>
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</base:WindowBase>
