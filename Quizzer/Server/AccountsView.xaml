<base:WindowBase x:Class="Quizzer.Server.AccountsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:base="clr-namespace:Quizzer.Base"
        xmlns:local="clr-namespace:Quizzer.Server"
        Title="Konten" Height="620" Width="980"
        WindowStartupLocation="CenterOwner">
    <base:WindowBase.DataContext>
        <local:AccountsViewModel />
    </base:WindowBase.DataContext>

    <Grid Background="{StaticResource AppBgBrush}" Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Column="0" Grid.Row="0" Margin="0,0,16,0">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                <PasswordBox x:Name="Zuruecksetzen" Width="180" Height="30" PasswordChanged="ResetChanged"
                             ToolTip="Neues Kennwort für das gewählte Konto." />
                <Button Content="Kennwort setzen" Command="{Binding ResetPasswordCommand}" Margin="8,0,0,0" Padding="10,4"
                        ToolTip="Setzt das Kennwort des gewählten Kontos und beendet seine Sitzungen." />
                <Button Content="Sperren / entsperren" Command="{Binding ToggleDisabledCommand}" Margin="8,0,0,0" Padding="10,4"
                        ToolTip="Ein gesperrtes Konto verliert seinen Zugang sofort." />
                <Button Content="Admin ja / nein" Command="{Binding ToggleAdminCommand}" Margin="8,0,0,0" Padding="10,4"
                        ToolTip="Nur ein Admin verwaltet Konten und sieht alle Spiele." />
            </StackPanel>

            <DataGrid ItemsSource="{Binding Accounts}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Benutzer" Binding="{Binding UserName}" Width="*" />
                    <DataGridTextColumn Header="Mitspieler" Binding="{Binding PlayerName}" Width="*" />
                    <DataGridTextColumn Header="Rolle" Binding="{Binding Role}" Width="Auto" />
                    <DataGridCheckBoxColumn Header="Gesperrt" Binding="{Binding IsDisabled}" Width="Auto" />
                    <DataGridTextColumn Header="Zuletzt angemeldet" Binding="{Binding LastLoginAt, StringFormat=g}" Width="Auto" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <StackPanel Grid.Column="1" Grid.Row="0">
            <TextBlock Text="Neues Konto" Style="{StaticResource SectionHeader}" />

            <TextBlock Text="Benutzername" FontSize="12" Opacity="0.8" />
            <TextBox Text="{Binding NewUserName, UpdateSourceTrigger=PropertyChanged}" Height="30" />

            <TextBlock Text="Kennwort (mindestens 12 Zeichen)" FontSize="12" Opacity="0.8" Margin="0,8,0,0" />
            <PasswordBox x:Name="NeuesKennwort" PasswordChanged="NewChanged" Height="30" />

            <TextBlock Text="Für einen bestehenden Mitspieler ohne Konto" FontSize="12" Opacity="0.8" Margin="0,8,0,0" />
            <ComboBox ItemsSource="{Binding PlayersWithoutAccount}" SelectedItem="{Binding PlayerForNewAccount, Mode=TwoWay}"
                      DisplayMemberPath="CalculatedDisplayName" Height="30"
                      ToolTip="Leer lassen, dann entsteht ein neuer Mitspieler." />

            <TextBlock Text="… oder Name des neuen Mitspielers" FontSize="12" Opacity="0.8" Margin="0,8,0,0" />
            <TextBox Text="{Binding NewPlayerName, UpdateSourceTrigger=PropertyChanged}" Height="30" />

            <CheckBox Content="Admin" IsChecked="{Binding NewIsAdmin}" Margin="0,10,0,0" />

            <Button Content="Konto anlegen" Command="{Binding CreateCommand}" Height="34" FontWeight="Bold" Margin="0,14,0,0"
                    ToolTip="Legt das Konto am Server an." />
        </StackPanel>

        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,12,0,0" />
    </Grid>
</base:WindowBase>
