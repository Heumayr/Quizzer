<base:WindowBase x:Class="Quizzer.Server.ServerLoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:base="clr-namespace:Quizzer.Base"
        xmlns:local="clr-namespace:Quizzer.Server"
        Title="Anmelden" Height="460" Width="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <base:WindowBase.DataContext>
        <local:ServerLoginViewModel />
    </base:WindowBase.DataContext>

    <base:WindowBase.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding SignInCommand}" />
    </base:WindowBase.InputBindings>

    <Grid Background="{StaticResource AppBgBrush}" Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Quizzer" FontSize="34" FontWeight="Bold" Foreground="{StaticResource ForegroundBrush}" />
            <TextBlock Opacity="0.65" FontSize="14" Margin="0,4,0,0">
                <Run Text="Anmelden am Server" />
                <Run Text="{Binding ServerText, Mode=OneWay}" FontWeight="SemiBold" />
            </TextBlock>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,24,0,0">
            <StackPanel Visibility="{Binding FormVisibility}">
                <TextBlock Text="Benutzername" Style="{StaticResource SectionHeader}" />
                <TextBox x:Name="Namensfeld" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Height="34"
                         VerticalContentAlignment="Center" />

                <TextBlock Text="Kennwort" Style="{StaticResource SectionHeader}" Margin="0,12,0,0" />
                <PasswordBox x:Name="Kennwortfeld" PasswordChanged="Kennwortfeld_PasswordChanged" Height="34" />

                <TextBlock Text="{Binding Error}" Visibility="{Binding ErrorVisibility}"
                           Foreground="#FF8A80" Margin="0,10,0,0" TextWrapping="Wrap" />

                <Button Content="Ohne Server mit dem letzten Stand weiterarbeiten"
                        Command="{Binding OfflineCommand}" Visibility="{Binding OfflineVisibility}"
                        Margin="0,12,0,0" Height="32" HorizontalAlignment="Left" Padding="12,0"
                        ToolTip="Öffnet die Daten deiner letzten Anmeldung auf diesem Rechner. Änderungen gehen beim nächsten Anmelden an den Server." />
            </StackPanel>

            <StackPanel Visibility="{Binding BusyVisibility}" VerticalAlignment="Center">
                <TextBlock Text="{Binding Busy}" FontSize="16" HorizontalAlignment="Center" TextWrapping="Wrap" />
                <ProgressBar IsIndeterminate="True" Height="6" Margin="40,16,40,0" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Button Content="Einstellungen" Command="{Binding SettingsCommand}" HorizontalAlignment="Left"
                    MinWidth="120" Height="36"
                    ToolTip="Serveradresse und Fingerabdruck des Zertifikats ändern." />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Beenden" Command="{Binding CancelCommand}" MinWidth="110" Height="36" Margin="0,0,8,0"
                        ToolTip="Schließt das Programm, ohne anzumelden." />
                <Button Content="Anmelden" Command="{Binding SignInCommand}" MinWidth="150" Height="36"
                        FontWeight="Bold" IsDefault="True"
                        ToolTip="Meldet dich an und lädt alle Daten, die du sehen darfst." />
            </StackPanel>
        </Grid>
    </Grid>
</base:WindowBase>
