# Vorlage. new-secrets.ps1 (oder new-secrets.sh) legt daraus eine .env mit Zufallswerten an.
# Die .env gehoert NIE ins Repo (steht in .gitignore).

QUIZZER_SA_PASSWORD=
QUIZZER_APP_PASSWORD=
QUIZZER_JWT_KEY=
# Kein "admin": ein bekannter Name laesst sich von aussen mit 5 Fehlversuchen sperren.
# new-secrets setzt einen zufaelligen Namen ein (leitung-xxxxxx).
QUIZZER_ADMIN_USER=
QUIZZER_ADMIN_PASSWORD=

# Wo der Port auf dem Rechner lauscht. 127.0.0.1 = nur lokal. Mit Tailscale die
# Tailscale-Adresse des Rechners (tailscale ip -4), dann ist er nur im Tailnet erreichbar.
QUIZZER_BIND_ADDRESS=127.0.0.1
QUIZZER_PORT=8443

# Der Tailscale-Name des Rechners (<rechner>.<tailnet>.ts.net) - fuer zertifikat-erneuern.
QUIZZER_TS_HOSTNAME=

# Wie viele Sicherungen in backups/ bleiben (die neuesten), und wohin jede zusaetzlich kopiert
# wird - ein zweiter Datentraeger, ein NAS-Ordner, ein synchronisierter Cloud-Ordner. Leer = keine
# Kopie. Eine Sicherung nur auf demselben Rechner ist keine.
QUIZZER_BACKUP_KEEP=14
QUIZZER_BACKUP_COPY_TO=
