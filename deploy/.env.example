# Vorlage. new-secrets.ps1 (oder new-secrets.sh) legt daraus eine .env mit Zufallswerten an.
# Die .env gehoert NIE ins Repo (steht in .gitignore).

QUIZZER_SA_PASSWORD=
QUIZZER_APP_PASSWORD=
QUIZZER_JWT_KEY=
QUIZZER_ADMIN_USER=admin
QUIZZER_ADMIN_PASSWORD=

# Wo der Port auf dem Rechner lauscht. 127.0.0.1 = nur lokal. Mit Tailscale die
# Tailscale-Adresse des Rechners (tailscale ip -4), dann ist er nur im Tailnet erreichbar.
QUIZZER_BIND_ADDRESS=127.0.0.1
QUIZZER_PORT=8443
