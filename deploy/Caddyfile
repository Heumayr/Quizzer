# Caddy vor dem Quizzer-Server: TLS, Groessengrenze, Sicherheitskoepfe.
#
# Das Zertifikat kommt aus certs/ - dieselben Dateien, die bisher Kestrel las (tailscale cert
# oder selbst erzeugt, siehe README.md). Damit bleibt der Fingerabdruck im WPF gueltig.
# Caddy holt bewusst kein eigenes: der Rechner ist aus dem Internet nicht erreichbar, und ein
# alle 12 Stunden erneuertes internes Zertifikat liesse sich im WPF nicht anheften.

{
	# Keine Verwaltungsschnittstelle, kein Port 80, keine Zertifikatsbeschaffung.
	admin off
	auto_https off

	# Kein HTTP/3: es liefe ueber UDP, und compose veroeffentlicht nur TCP - die Clients
	# versuchten es sonst vergeblich (alt-svc).
	servers {
		protocols h1 h2
		# Echte Absenderadresse hinter dem Cloudflare Tunnel (M36 A3): Cf-Connecting-Ip zaehlt nur,
		# wenn die Anfrage vom Tunnel-Container kommt. Ueber die lokale Tuer bleibt ein solcher Kopf
		# wirkungslos. Die Vorgabe gilt fuer den Betriebsstapel, der Pruefstapel setzt seine Adresse.
		trusted_proxies static {$QUIZZER_TUNNEL_IP:172.30.77.11}/32
		client_ip_headers Cf-Connecting-Ip
	}
}

:8443 {
	tls /certs/server.crt /certs/server.key {
		protocols tls1.2 tls1.3
	}

	# Etwas ueber Quizzer:MaxMediaBytes (200 MB) - die genaue Grenze prueft die API selbst.
	request_body {
		max_size 210MB
	}

	header {
		Strict-Transport-Security "max-age=15552000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		# Die API liefert nur JSON und Medien an das WPF - kein Browser braucht Inhalte oder Rahmen (M36 A5).
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		X-Frame-Options "DENY"
		-Server
		-Via
	}

	# Genau ein Wert fuer die API: die Gegenstelle, beim Tunnel dessen Cf-Connecting-Ip. Die API
	# glaubt X-Forwarded-For nur Caddy und nur einen Sprung (ForwardLimit 1).
	reverse_proxy api:8080 {
		header_up X-Forwarded-For {client_ip}
	}

	log {
		output stdout
		format console
	}
}
